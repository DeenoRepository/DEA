<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EquipmentFailureAnalysis.Views"
             x:Class="EquipmentFailureAnalysis.Views.FailureAnalysisView">
    <Grid x:Name="FailureAnalysisLayoutRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="FailureAnalysisCenterColumn" Grid.Column="0" Margin="0,12,8,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
              <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Spacing="10">
                        <!-- Top header showing day numbers moved into heatmap block for alignment -->
        
                      <Grid>
        					<Border Background="Transparent" CornerRadius="8" Margin="0,6,0,0" />
        					<Border Background="{StaticResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        						<StackPanel Spacing="8">
        							<TextBlock Text="Универсальный фильтр" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        							<TextBlock Text="Фильтрация по типу, статусу, ответственному и оборудованию" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    <Grid ColumnDefinitions="Auto,140,Auto,160,Auto,190,Auto,170,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        								<TextBlock Grid.Column="0" Text="Тип:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="1"
        									ItemsSource="{Binding DowntimeIssueTypeFilters}"
        									SelectedItem="{Binding SelectedDowntimeIssueTypeFilter, Mode=TwoWay}"
        									Background="{StaticResource SurfaceBrush}"
        									BorderBrush="{StaticResource ControlBorderBrush}"
        									BorderThickness="1" />
        								<TextBlock Grid.Column="2" Text="Статус:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="3"
        									ItemsSource="{Binding DowntimeStatusFilters}"
        									SelectedItem="{Binding SelectedDowntimeStatusFilter, Mode=TwoWay}"
        									Background="{StaticResource SurfaceBrush}"
        									BorderBrush="{StaticResource ControlBorderBrush}"
        									BorderThickness="1" />
        								<TextBlock Grid.Column="4" Text="Ответственный:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="5"
        									ItemsSource="{Binding DowntimeResponsibleFilters}"
        									SelectedItem="{Binding SelectedDowntimeResponsibleFilter, Mode=TwoWay}"
        									Background="{StaticResource SurfaceBrush}"
        									BorderBrush="{StaticResource ControlBorderBrush}"
        									BorderThickness="1" />
                                        <TextBlock Grid.Column="6" Text="Группа:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="7"
        									ItemsSource="{Binding DowntimeSubdivisionFilters}"
        									SelectedItem="{Binding SelectedDowntimeSubdivisionFilter, Mode=TwoWay}"
        									Background="{StaticResource SurfaceBrush}"
        									BorderBrush="{StaticResource ControlBorderBrush}"
        									BorderThickness="1" />
        								<TextBlock Grid.Column="8" Text="Оборудование:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        								<TextBox Grid.Column="9"
        									Watermark="Поиск по названию или инв. номеру"
        									Text="{Binding DowntimeEquipmentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        									Background="{StaticResource SurfaceBrush}"
        									BorderBrush="{StaticResource ControlBorderBrush}"
        									BorderThickness="1" />
                                     <Button Grid.Column="10"
                                         Classes="resetFilter"
        									Content="Сброс"
        									Command="{Binding ResetUniversalFiltersCommand}" />
        							</Grid>
        						</StackPanel>
        					</Border>
        				</Grid>
        
                        <Grid>
                         <Border Background="Transparent" CornerRadius="8" Margin="0,6,0,0" />
        						<Border Background="{StaticResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                          <StackPanel HorizontalAlignment="Stretch">
                             <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
        							<TextBlock Grid.Column="0" Text="Карта тепла" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        							<Button Grid.Column="1" Classes="smallIcon" Content="..." FontSize="14" ToolTip.Tip="Настройки градации" Click="FailureHeatmapSettingsButton_Click">
        								<Button.Flyout>
        									<Flyout Placement="BottomEdgeAlignedRight">
        										<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Padding="10">
                                                    <StackPanel Spacing="8" MinWidth="320" MaxWidth="360">
        												<TextBlock Text="Настройки градации карты" FontSize="12" FontWeight="SemiBold" />
        												<TextBlock Text="Диапазон значений для карты неисправностей" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                                       <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8" VerticalAlignment="Center">
        													<TextBlock Grid.Row="0" Grid.Column="0" Text="Минимум:" FontSize="12" VerticalAlignment="Center" />
        													<NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1000" Increment="1" FormatString="F0" Value="{Binding HeatmapColorMin, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        													<TextBlock Grid.Row="1" Grid.Column="0" Text="Максимум:" FontSize="12" VerticalAlignment="Center" />
        													<NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000" Increment="1" FormatString="F0" Value="{Binding HeatmapColorMax, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        												</Grid>
        											</StackPanel>
        										</Border>
        									</Flyout>
        								</Button.Flyout>
        							</Button>
        						</Grid>
        						<TextBlock Text="Ежедневная интенсивность неисправностей по месяцам" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                            <views:HeatmapGridControl DayHeaders="{Binding DayHeaders}"
                                                     MonthRows="{Binding MonthRows}"
                                                     CellCommand="{Binding ShowDayTimelineCommand}"
                                                     ConverterMode="FailureAnalysis" />
        
        						<!-- Heatmap legend -->
        						<StackPanel Orientation="Horizontal" Margin="8,6,0,0" HorizontalAlignment="Left">
        							<TextBlock Text="Легенда:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,8,0" />
        							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        								<Border Width="24" Height="14" Background="{StaticResource HeatmapGreen}" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" />
        								<TextBlock Text=" 0" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
        							</StackPanel>
        							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        								<Border Width="24" Height="14" Background="{StaticResource HeatmapYellow}" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" />
        								<TextBlock Text=" 3-6" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
        							</StackPanel>
        							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        								<Border Width="24" Height="14" Background="{StaticResource HeatmapOrange}" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" />
        								<TextBlock Text=" 7-9" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
        							</StackPanel>
        							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        								<Border Width="24" Height="14" Background="{StaticResource HeatmapRed}" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" />
        								<TextBlock Text=" 10+" VerticalAlignment="Center" Foreground="#444" Margin="6,0,0,0" />
        							</StackPanel>
        						</StackPanel>
                            </StackPanel>
        					</Border>
        				</Grid>
        
        				<!-- Timeline panel showing 24-hour state blocks under heatmap -->
                        <Grid>
                         <Border Background="Transparent" CornerRadius="8" Margin="0,6,0,0" />
        					<Border Background="{StaticResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
        						<TextBlock Text="График простоев" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
        						<TextBlock Text="Динамика ремонтов и настроек в течение суток" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                                <Grid>
                                    <views:TimelineControl Items="{Binding DayTimelinePoints}" RepairsItems="{Binding RepairsTimelinePoints}" SetupsItems="{Binding SetupsTimelinePoints}" Annotations="{Binding Annotations}" AnnotationSelectedCommand="{Binding SelectTimelineAnnotationCommand}" Height="180" ShowHourLabels="True" VerticalAlignment="Top" />
        							<Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Background="{StaticResource OverlaySurfaceBrush}" BorderBrush="{StaticResource OverlayBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6">
        								<StackPanel Spacing="4">
        									<StackPanel Orientation="Horizontal" Spacing="6">
        								<Border Width="14" Height="3" Background="{StaticResource LegendRepairBrush}" VerticalAlignment="Center" />
        										<TextBlock Text="Ремонт" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        									</StackPanel>
        									<StackPanel Orientation="Horizontal" Spacing="6">
        								<Border Width="14" Height="3" Background="{StaticResource LegendSetupBrush}" VerticalAlignment="Center" />
        										<TextBlock Text="Настройка" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        									</StackPanel>
        									<StackPanel Orientation="Horizontal" Spacing="6">
        								<Border Width="14" Height="3" Background="{StaticResource LegendOverlapBrush}" VerticalAlignment="Center" />
        										<TextBlock Text="Пересечение" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        									</StackPanel>
        								</StackPanel>
        							</Border>
        						</Grid>
        					</StackPanel>
        				</Border>
        				</Grid>
        		</StackPanel>
        		</ScrollViewer>
          <Grid x:Name="FailureAnalysisRightColumn" Grid.Column="1" Margin="8,0,0,0" MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
             <Border Background="{StaticResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0" CornerRadius="0" Padding="14">
                  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
 
                     <TextBlock Grid.Row="0" Text="Статистика" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                       <TextBlock Grid.Row="0" Text="Сводка выбранного оборудования и дня" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,22,0,0" />
 
                       <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                           <Border Grid.Column="0" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" HorizontalAlignment="Stretch" MinWidth="120">
                               <StackPanel>
                                   <TextBlock Text="Оборудование" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2" />
                                   <TextBlock Text="{Binding SelectedEquipment.Title}" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                     <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="{Binding SelectedEquipment.InventoryNumber, StringFormat='Инв. №: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                         <Button Grid.Column="1" Classes="smallIcon" Width="18" Height="18" Padding="0" Margin="4,0,0,0" ToolTip.Tip="Копировать инвентарный номер" Click="CopyInventoryNumberButton_Click" Background="Transparent" BorderThickness="0">
                                             <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                         </Button>
                                     </Grid>
                               </StackPanel>
                           </Border>
                           <Border Grid.Column="1" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Width="120" Margin="8,0,0,0">
                               <StackPanel>
                                   <TextBlock Text="Дата" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                   <TextBlock Text="{Binding AnalysisDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontWeight="Bold" />
                               </StackPanel>
                           </Border>
                       </Grid>
 
                       <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                           <StackPanel Spacing="8">
                               <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="6">
                                   <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                                       <StackPanel>
                                           <TextBlock Text="Ремонты" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                           <TextBlock Text="{Binding SelectedDayRepairs, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                       </StackPanel>
                                   </Border>
                                   <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                                       <StackPanel>
                                           <TextBlock Text="Настройки" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                           <TextBlock Text="{Binding SelectedDaySetups, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                       </StackPanel>
                                   </Border>
                                   <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                                       <StackPanel>
                                           <TextBlock Text="Работа" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                           <TextBlock Text="{Binding WorkPercent, StringFormat='{}{0:0.0}%'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SuccessStrongBrush}" />
                                       </StackPanel>
                                   </Border>
                                   <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                                       <StackPanel>
                                           <TextBlock Text="Ср. ремонт" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                           <TextBlock Text="{Binding AvgRepairTime}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                       </StackPanel>
                                   </Border>
                               </Grid>
                             <StackPanel Orientation="Horizontal" Spacing="10">
                                   <TextBlock Text="{Binding RepairsLastMonth, StringFormat='Ремонтов за 30 дн.: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                   <TextBlock Text="{Binding SetupsLastMonth, StringFormat='Настроек: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" />
                               </StackPanel>
                               <ProgressBar Value="{Binding WorkPercent}" Maximum="100" Minimum="0" Height="8" />
                           </StackPanel>
                       </Border>
 
                       <Border Grid.Row="3" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Stretch">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Детализация события" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Подробная информация о выбранном интервале" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
 
                                <Border Height="1" Background="{StaticResource RowDividerBrush}" />
 
                                <!-- Группа: Основное -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ОСНОВНЫЕ СВЕДЕНИЯ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" LetterSpacing="0.05" />
                                    
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип события:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <Border Classes="badge badge-danger" Classes.badge-danger="{Binding IsSelectedTimelineRepair}" Classes.badge-warning="{Binding IsSelectedTimelineSetup}" Classes.badge-info="{Binding !SelectedTimelineHasData}" IsVisible="{Binding SelectedTimelineHasData}">
                                                <TextBlock Text="{Binding SelectedTimelineType}" />
                                            </Border>
                                            <TextBlock Text="-" IsVisible="{Binding !SelectedTimelineHasData}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                        </StackPanel>
 
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <Border Classes="badge badge-warning" Classes.badge-warning="{Binding IsSelectedTimelineInProgress}" Classes.badge-success="{Binding IsSelectedTimelineCompleted}" IsVisible="{Binding SelectedTimelineHasData}">
                                                <TextBlock Text="{Binding SelectedTimelineStatus}" />
                                            </Border>
                                            <TextBlock Text="-" IsVisible="{Binding !SelectedTimelineHasData}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                        </StackPanel>
 
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Код Jira:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding SelectedTimelineJiraKey}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="smallIcon" Width="18" Height="18" Padding="0" Margin="4,0,0,0" ToolTip.Tip="Скопировать ключ задачи" Click="CopyJiraKeyButton_Click" Background="Transparent" BorderThickness="0" IsVisible="{Binding SelectedTimelineHasData}">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
 
                                <Border Height="1" Background="{StaticResource RowDividerBrush}" />
 
                                <!-- Группа: Время -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ВРЕМЕННЫЕ ПОКАЗАТЕЛИ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" LetterSpacing="0.05" />
                                    
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Начало:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTimelineStart}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
 
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Завершение:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTimelineEnd}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
 
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Длительность:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTimelineDuration}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentForeground}" />
                                    </Grid>
                                </StackPanel>
 
                                <Border Height="1" Background="{StaticResource RowDividerBrush}" />
 
                                <!-- Группа: Исполнители и детали -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ИСПОЛНЕНИЕ И ОПИСАНИЕ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" LetterSpacing="0.05" />
                                    
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ответственный:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTimelineResponsible}" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
 
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Заявитель:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTimelineReporter}" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
 
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTimelineDescription}" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
 
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Комментарии:" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTimelineComments}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
         						</Border>
         					</Grid>
         				</Border>
          </Grid>
        
    </Grid>
</UserControl>





