<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EquipmentFailureAnalysis.Views"
             x:Class="EquipmentFailureAnalysis.Views.FailureAnalysisView">

    <Grid x:Name="FailureAnalysisLayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" />
            <ColumnDefinition Width="*" MinWidth="320" MaxWidth="480" />
        </Grid.ColumnDefinitions>

        <!-- ====================================================
             CENTER COLUMN — Filters / Heatmap / Timeline
             ==================================================== -->
        <ScrollViewer x:Name="FailureAnalysisCenterColumn"
                      Grid.Column="0"
                      Margin="20,18,16,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- ============== PAGE HEADER ============== -->
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Анализ неисправностей" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Глубокая детализация инцидентов по дням и оборудованию"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                    <!-- Layout switcher -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentSoftBackground}"
                                BorderBrush="{DynamicResource AccentSoftBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="10,5"
                                VerticalAlignment="Center"
                                IsVisible="{Binding MonthRows.Count}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource AccentForeground}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="FailureYearLabel"
                                           Text="{Binding HeatmapYearLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentForeground}"
                                            VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============== UNIVERSAL FILTER BAR ============== -->
                <Border Classes="panelFlat" Padding="0">
                    <Expander x:Name="FilterExpander" IsExpanded="False" HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,2">
                                <Border Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBackground}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{DynamicResource AccentForeground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="Универсальный фильтр" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Тип, статус, ответственный, группа, оборудование"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Classes="resetFilter"
                                        Content="Сбросить"
                                        Margin="8,0,0,0"
                                        Command="{Binding ResetUniversalFiltersCommand}"
                                        Click="ResetFiltersWithToast_Click" />
                            </Grid>
                        </Expander.Header>

                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <Border Height="1" Background="{DynamicResource RowDividerBrush}" />

                            <Grid ColumnDefinitions="Auto,*,12,Auto,*,12,Auto,*,12,Auto,*"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="8" ColumnSpacing="0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding DowntimeIssueTypeFilters}"
                                          SelectedItem="{Binding SelectedDowntimeIssueTypeFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Статус"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="4"
                                          ItemsSource="{Binding DowntimeStatusFilters}"
                                          SelectedItem="{Binding SelectedDowntimeStatusFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="0" Grid.Column="6" Text="Ответственный"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="7"
                                          ItemsSource="{Binding DowntimeResponsibleFilters}"
                                          SelectedItem="{Binding SelectedDowntimeResponsibleFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="0" Grid.Column="9" Text="Группа"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="10"
                                          ItemsSource="{Binding DowntimeSubdivisionFilters}"
                                          SelectedItem="{Binding SelectedDowntimeSubdivisionFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Оборудование"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="10"
                                         Watermark="Поиск по названию или инв. номеру"
                                         Text="{Binding DowntimeEquipmentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- ============== HEATMAP CARD ============== -->
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Карта тепла" Classes="sectionTitle" />
                                <TextBlock Text="Ежедневная интенсивность неисправностей по месяцам"
                                           Classes="sectionSubtitle" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="smallIcon"
                                    ToolTip.Tip="Настройки градации"
                                    Click="FailureHeatmapSettingsButton_Click">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <Border Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10" Padding="14">
                                            <StackPanel Spacing="10" MinWidth="320" MaxWidth="360">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Настройки градации карты"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="Диапазон значений для карты неисправностей"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Height="1" Background="{DynamicResource RowDividerBrush}" />
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                                      ColumnSpacing="10" RowSpacing="8" VerticalAlignment="Center">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Минимум"
                                                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center" />
                                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1000"
                                                                   Increment="1" FormatString="F0"
                                                                   Value="{Binding HeatmapColorMin, Mode=TwoWay}"
                                                                   HorizontalAlignment="Stretch" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Максимум"
                                                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center" />
                                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000"
                                                                   Increment="1" FormatString="F0"
                                                                   Value="{Binding HeatmapColorMax, Mode=TwoWay}"
                                                                   HorizontalAlignment="Stretch" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <Border Classes="well" Padding="0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Carousel Scroll Left -->
                                <Button Grid.Column="0"
                                        Classes="ghost"
                                        Width="32" Height="32"
                                        VerticalAlignment="Center"
                                        Margin="6,0"
                                        Click="HeatmapScrollLeft_Click"
                                        ToolTip.Tip="Предыдущие месяцы">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <ScrollViewer x:Name="FailureHeatmapScroller"
                                              Grid.Column="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              Background="Transparent">
                                    <views:HeatmapGridControl DayHeaders="{Binding DayHeaders}"
                                                             MonthRows="{Binding MonthRows}"
                                                             CellCommand="{Binding ShowDayTimelineCommand}"
                                                             SelectedDate="{Binding AnalysisDate, Mode=TwoWay}"
                                                             ConverterMode="FailureAnalysis" />
                                </ScrollViewer>

                                <!-- Carousel Scroll Right -->
                                <Button Grid.Column="2"
                                        Classes="ghost"
                                        Width="32" Height="32"
                                        VerticalAlignment="Center"
                                        Margin="6,0"
                                        Click="HeatmapScrollRight_Click"
                                        ToolTip.Tip="Следующие месяцы">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <!-- Empty state for heatmap -->
                                <Border Grid.ColumnSpan="3"
                                        Classes="emptyState"
                                        IsVisible="{Binding MonthRows, Converter={StaticResource IsEmptyConverter}}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="320">
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{DynamicResource AccentSoftBackground}">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource AccentForeground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Classes="emptyStateTitle" Text="Нет данных для отображения"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Classes="emptyStateSubtitle"
                                                   Text="Импортируйте данные из XML или Jira, чтобы увидеть карту неисправностей"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Legend (reactive to HeatmapColorMin/Max) -->
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,2,0,0">
                            <TextBlock Text="Градация:" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="22" Height="12" Background="{StaticResource HeatmapGreen}" CornerRadius="4" />
                                <TextBlock Text="{Binding HeatmapColorMin, StringFormat='до {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="22" Height="12" Background="{StaticResource HeatmapYellow}" CornerRadius="4" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}–{1}">
                                            <Binding Path="HeatmapColorMin" />
                                            <Binding Path="HeatmapColorMax" Converter="{StaticResource HeatmapMidValueConverter}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="22" Height="12" Background="{StaticResource HeatmapOrange}" CornerRadius="4" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}–{1}">
                                            <Binding Path="HeatmapColorMax" Converter="{StaticResource HeatmapMidValueConverter}" />
                                            <Binding Path="HeatmapColorMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="22" Height="12" Background="{StaticResource HeatmapRed}" CornerRadius="4" />
                                <TextBlock Text="{Binding HeatmapColorMax, StringFormat='от {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============== TIMELINE PANEL ============== -->
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="График простоев" Classes="sectionTitle" />
                                <TextBlock Text="Динамика ремонтов и настроек в течение суток"
                                           Classes="sectionSubtitle" />
                            </StackPanel>
                        </Grid>

                        <Border Classes="well" Padding="10">
                            <Grid>
                                <views:TimelineControl Items="{Binding DayTimelinePoints}"
                                                       RepairsItems="{Binding RepairsTimelinePoints}"
                                                       SetupsItems="{Binding SetupsTimelinePoints}"
                                                       Annotations="{Binding Annotations}"
                                                       AnnotationSelectedCommand="{Binding SelectTimelineAnnotationCommand}"
                                                       Height="180" ShowHourLabels="True"
                                                       VerticalAlignment="Top" />

                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,8,8,0"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="8,6">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="14" Height="3" Background="{DynamicResource LegendRepairBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Ремонт" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="14" Height="3" Background="{DynamicResource LegendSetupBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Настройка" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="14" Height="3" Background="{DynamicResource LegendOverlapBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Пересечение" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ====================================================
             RIGHT COLUMN — Equipment / Day stats / Event details
             ==================================================== -->
        <Grid x:Name="FailureAnalysisRightColumn" Grid.Column="1"
              MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">

                        <!-- Section header -->
                        <StackPanel Spacing="2">
                            <TextBlock Classes="eyebrow" Text="СВОДКА · ВЫБРАННЫЙ ДЕНЬ" />
                            <TextBlock Text="Оборудование и инциденты" Classes="sectionTitle" />
                            <TextBlock Text="Сводные показатели и подробности выбранного события"
                                       Classes="sectionSubtitle" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Equipment + Date pair -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Classes="well">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="6"
                                                Background="{DynamicResource AccentSoftBackground}">
                                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentForeground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Оборудование" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedEquipment.Title}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding SelectedEquipment.InventoryNumber, StringFormat='Инв. №: {0}'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1"
                                                Classes="smallIcon" Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                                                ToolTip.Tip="Копировать инвентарный номер"
                                                Click="CopyInventoryNumberButton_Click"
                                                Background="Transparent" BorderThickness="0">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="well" Width="120">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="6"
                                                Background="{DynamicResource InfoSoftBackground}">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource InfoBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Дата" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AnalysisDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- KPI 2x2 -->
                        <Border Classes="well">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Сводные показатели" Classes="cardTitle" />
                                    <TextBlock Text="За выбранный день по выбранному оборудованию"
                                               Classes="cardSubtext" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                      RowSpacing="10" ColumnSpacing="10">
                                    <Border Grid.Row="0" Grid.Column="0"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Ремонты" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding SelectedDayRepairs, StringFormat='{}{0} шт.'}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Настройки" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding SelectedDaySetups, StringFormat='{}{0} шт.'}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Доля работы" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding WorkPercent, StringFormat='{}{0:0.0}%'}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessStrongBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Ср. ремонт" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding AvgRepairTime}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentForeground}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                Background="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="{Binding RepairsLastMonth, StringFormat='Ремонтов за 30 дн.: {0}'}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                Background="{DynamicResource WarningBrush}" />
                                        <TextBlock Text="{Binding SetupsLastMonth, StringFormat='Настроек: {0}'}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </StackPanel>

                                <ProgressBar Value="{Binding WorkPercent}" Maximum="100" Minimum="0" />
                            </StackPanel>
                        </Border>

                        <!-- Event details -->
                        <Border Classes="panelFlat" Padding="14">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Детализация события" Classes="cardTitle" />
                                    <TextBlock Text="Подробная информация о выбранном интервале"
                                               Classes="cardSubtext" />
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource RowDividerBrush}" />

                                <!-- Группа: Основное -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ОСНОВНЫЕ СВЕДЕНИЯ" Classes="eyebrow" />

                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип события"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <Border Classes="badge badge-danger"
                                                    Classes.badge-danger="{Binding IsSelectedTimelineRepair}"
                                                    Classes.badge-warning="{Binding IsSelectedTimelineSetup}"
                                                    Classes.badge-info="{Binding !SelectedTimelineHasData}"
                                                    IsVisible="{Binding SelectedTimelineHasData}">
                                                <TextBlock Text="{Binding SelectedTimelineType}" />
                                            </Border>
                                            <TextBlock Text="—"
                                                       IsVisible="{Binding !SelectedTimelineHasData}"
                                                       FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <Border Classes="badge badge-warning"
                                                    Classes.badge-warning="{Binding IsSelectedTimelineInProgress}"
                                                    Classes.badge-success="{Binding IsSelectedTimelineCompleted}"
                                                    IsVisible="{Binding SelectedTimelineHasData}">
                                                <TextBlock Text="{Binding SelectedTimelineStatus}" />
                                            </Border>
                                            <TextBlock Text="—"
                                                       IsVisible="{Binding !SelectedTimelineHasData}"
                                                       FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Код Jira"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       IsVisible="{Binding SelectedTimelineHasData}"
                                                       Text="{Binding SelectedTimelineJiraKey}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="0"
                                                       IsVisible="{Binding !SelectedTimelineHasData}"
                                                       Text="—"
                                                       FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Classes="smallIcon" Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                                                    ToolTip.Tip="Скопировать ключ задачи"
                                                    Click="CopyJiraKeyButton_Click"
                                                    Background="Transparent" BorderThickness="0"
                                                    IsVisible="{Binding SelectedTimelineHasData}">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource RowDividerBrush}" />

                                <!-- Группа: Время -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ВРЕМЕННЫЕ ПОКАЗАТЕЛИ" Classes="eyebrow" />

                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Начало"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTimelineStart}"
                                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Завершение"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTimelineEnd}"
                                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Длительность"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTimelineDuration}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentForeground}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource RowDividerBrush}" />

                                <!-- Группа: Исполнители и детали -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ИСПОЛНЕНИЕ И ОПИСАНИЕ" Classes="eyebrow" />

                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ответственный"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTimelineResponsible}"
                                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Заявитель"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTimelineReporter}"
                                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTimelineDescription}"
                                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Комментарии"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTimelineComments}"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
