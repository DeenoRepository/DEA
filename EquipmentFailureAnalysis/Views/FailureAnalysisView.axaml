<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EquipmentFailureAnalysis.Views"
             x:Class="EquipmentFailureAnalysis.Views.FailureAnalysisView">
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="1.9*" />
            </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="FailureAnalysisCenterColumn" Grid.Column="0" Margin="8,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
              <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Spacing="10">
                        <!-- Top header showing day numbers moved into heatmap block for alignment -->
        
                      <Grid>
        					<Border Background="Transparent" CornerRadius="8" Margin="0,6,0,0" />
        					<Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        						<StackPanel Spacing="8">
        							<TextBlock Text="Универсальный фильтр" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        							<TextBlock Text="Фильтрация по типу неисправности, ответственному и оборудованию" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    <Grid ColumnDefinitions="Auto,170,Auto,220,Auto,220,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        								<TextBlock Grid.Column="0" Text="Тип:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="1"
        									ItemsSource="{Binding DowntimeIssueTypeFilters}"
        									SelectedItem="{Binding SelectedDowntimeIssueTypeFilter, Mode=TwoWay}"
        									Background="{StaticResource SurfaceBrush}"
        									BorderBrush="{StaticResource ControlBorderBrush}"
        									BorderThickness="1" />
        								<TextBlock Grid.Column="2" Text="Ответственный:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="3"
        									ItemsSource="{Binding DowntimeResponsibleFilters}"
        									SelectedItem="{Binding SelectedDowntimeResponsibleFilter, Mode=TwoWay}"
        									Background="{StaticResource SurfaceBrush}"
        									BorderBrush="{StaticResource ControlBorderBrush}"
        									BorderThickness="1" />
                                        <TextBlock Grid.Column="4" Text="Группа:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="5"
        									ItemsSource="{Binding DowntimeSubdivisionFilters}"
        									SelectedItem="{Binding SelectedDowntimeSubdivisionFilter, Mode=TwoWay}"
        									Background="{StaticResource SurfaceBrush}"
        									BorderBrush="{StaticResource ControlBorderBrush}"
        									BorderThickness="1" />
        								<TextBlock Grid.Column="6" Text="Оборудование:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        								<TextBox Grid.Column="7"
        									Watermark="Поиск по названию или инв. номеру"
        									Text="{Binding DowntimeEquipmentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        									Background="{StaticResource SurfaceBrush}"
        									BorderBrush="{StaticResource ControlBorderBrush}"
        									BorderThickness="1" />
                                     <Button Grid.Column="8"
                                         Classes="resetFilter"
        									Content="Сброс"
        									Command="{Binding ResetUniversalFiltersCommand}" />
        							</Grid>
        						</StackPanel>
        					</Border>
        				</Grid>
        
                        <Grid>
                         <Border Background="Transparent" CornerRadius="8" Margin="0,6,0,0" />
        						<Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                          <StackPanel HorizontalAlignment="Stretch">
                             <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
        							<TextBlock Grid.Column="0" Text="Карта тепла" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        							<Button Grid.Column="1" Classes="smallIcon" Content="..." FontSize="14" ToolTip.Tip="Настройки градации" Click="FailureHeatmapSettingsButton_Click">
        								<Button.Flyout>
        									<Flyout Placement="BottomEdgeAlignedRight">
        										<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Padding="10">
                                                    <StackPanel Spacing="8" MinWidth="320" MaxWidth="360">
        												<TextBlock Text="Настройки градации карты" FontSize="12" FontWeight="SemiBold" />
        												<TextBlock Text="Диапазон значений для карты неисправностей" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                                       <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8" VerticalAlignment="Center">
        													<TextBlock Grid.Row="0" Grid.Column="0" Text="Минимум:" FontSize="12" VerticalAlignment="Center" />
        													<NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1000" Increment="1" FormatString="F0" Value="{Binding HeatmapColorMin, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        													<TextBlock Grid.Row="1" Grid.Column="0" Text="Максимум:" FontSize="12" VerticalAlignment="Center" />
        													<NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000" Increment="1" FormatString="F0" Value="{Binding HeatmapColorMax, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        												</Grid>
        											</StackPanel>
        										</Border>
        									</Flyout>
        								</Button.Flyout>
        							</Button>
        						</Grid>
        						<TextBlock Text="Ежедневная интенсивность неисправностей по месяцам" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
        						<Grid>
        							<!-- single scroll area that contains both day headers and month rows so they scroll together -->
                                    <ScrollViewer x:Name="HeatmapScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        								<StackPanel Margin="2">
                                            <!-- Day headers aligned with day cells (use width matching day cell width + margin) -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                                <TextBlock Width="72" />
        										<ItemsControl ItemsSource="{Binding DayHeaders}">
        											<ItemsControl.ItemsPanel>
        												<ItemsPanelTemplate>
        													<StackPanel Orientation="Horizontal" />
        												</ItemsPanelTemplate>
        											</ItemsControl.ItemsPanel>
        											<ItemsControl.ItemTemplate>
                                                        <DataTemplate>
        													<Border Width="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="2" Background="Transparent">
        														<TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#666" />
        													</Border>
        												</DataTemplate>
        											</ItemsControl.ItemTemplate>
        										</ItemsControl>
        									</StackPanel>
        
                                            <!-- Month rows -->
        									<ItemsControl ItemsSource="{Binding MonthRows}">
        										<ItemsControl.ItemsPanel>
        											<ItemsPanelTemplate>
        												<StackPanel Orientation="Vertical" />
        											</ItemsPanelTemplate>
        										</ItemsControl.ItemsPanel>
        										<ItemsControl.ItemTemplate>
        											<DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="2">
        													<TextBlock Text="{Binding MonthName}" Width="72" VerticalAlignment="Center" Margin="2" />
        													<ItemsControl ItemsSource="{Binding Days}">
        														<ItemsControl.ItemsPanel>
        															<ItemsPanelTemplate>
        																<StackPanel Orientation="Horizontal" />
        															</ItemsPanelTemplate>
        														</ItemsControl.ItemsPanel>
        														<ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Margin="2" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"
        																		Command="{Binding DataContext.ShowDayTimelineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        																		CommandParameter="{Binding Date}" IsVisible="{Binding IsValid}">
                                                                <Border Width="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="8" Background="{Binding ., Converter={StaticResource DayCellConverter}, ConverterParameter=FailureAnalysis}" BorderBrush="{Binding Date, Converter={StaticResource TodayBorderBrushConverter}}" BorderThickness="{Binding Date, Converter={StaticResource TodayBorderThicknessConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center">
        																		<TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{Binding Index, Converter={StaticResource IndexToForegroundConverter}}" />
        																	</Border>
                                                                        <ToolTip.Tip>
        																	<StackPanel>
        																		<TextBlock Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}" />
        																		<TextBlock Text="{Binding Index, StringFormat='Неисправностей: {0}'}" />
        																	</StackPanel>
        																</ToolTip.Tip>
        																<Button.ContextMenu>
        																	<ContextMenu>
                                                         <MenuItem Header="Показать в панели управления" Command="{Binding DataContext.LoadEquipmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.SelectedEquipment, RelativeSource={RelativeSource AncestorType=Window}}" />
        																	</ContextMenu>
        																</Button.ContextMenu>
        																</Button>
        															</DataTemplate>
        														</ItemsControl.ItemTemplate>
        													</ItemsControl>
        												</StackPanel>
        											</DataTemplate>
        										</ItemsControl.ItemTemplate>
                                            </ItemsControl>
        								</StackPanel>
        
        							</ScrollViewer>
        						</Grid>
        
        						<!-- Heatmap legend -->
        						<StackPanel Orientation="Horizontal" Margin="8,6,0,0" HorizontalAlignment="Left">
        							<TextBlock Text="Легенда:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,8,0" />
        							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        								<Border Width="24" Height="14" Background="{StaticResource HeatmapGreen}" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" />
        								<TextBlock Text=" 0" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
        							</StackPanel>
        							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        								<Border Width="24" Height="14" Background="{StaticResource HeatmapYellow}" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" />
        								<TextBlock Text=" 3-6" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
        							</StackPanel>
        							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        								<Border Width="24" Height="14" Background="{StaticResource HeatmapOrange}" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" />
        								<TextBlock Text=" 7-9" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
        							</StackPanel>
        							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        								<Border Width="24" Height="14" Background="{StaticResource HeatmapRed}" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" />
        								<TextBlock Text=" 10+" VerticalAlignment="Center" Foreground="#444" Margin="6,0,0,0" />
        							</StackPanel>
        						</StackPanel>
                            </StackPanel>
        					</Border>
        				</Grid>
        
        				<!-- Timeline panel showing 24-hour state blocks under heatmap -->
                        <Grid>
                         <Border Background="Transparent" CornerRadius="8" Margin="0,6,0,0" />
        					<Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
        						<TextBlock Text="График простоев" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
        						<TextBlock Text="Динамика ремонтов и настроек в течение суток" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                                <Grid>
                                    <views:TimelineControl Items="{Binding DayTimelinePoints}" RepairsItems="{Binding RepairsTimelinePoints}" SetupsItems="{Binding SetupsTimelinePoints}" Annotations="{Binding Annotations}" Height="410" ShowHourLabels="True" VerticalAlignment="Top" />
        							<Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Background="{StaticResource OverlaySurfaceBrush}" BorderBrush="{StaticResource OverlayBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6">
        								<StackPanel Spacing="4">
        									<StackPanel Orientation="Horizontal" Spacing="6">
        								<Border Width="14" Height="3" Background="{StaticResource LegendRepairBrush}" VerticalAlignment="Center" />
        										<TextBlock Text="Ремонт" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        									</StackPanel>
        									<StackPanel Orientation="Horizontal" Spacing="6">
        								<Border Width="14" Height="3" Background="{StaticResource LegendSetupBrush}" VerticalAlignment="Center" />
        										<TextBlock Text="Настройка" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        									</StackPanel>
        									<StackPanel Orientation="Horizontal" Spacing="6">
        								<Border Width="14" Height="3" Background="{StaticResource LegendOverlapBrush}" VerticalAlignment="Center" />
        										<TextBlock Text="Пересечение" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        									</StackPanel>
        								</StackPanel>
        							</Border>
        						</Grid>
        					</StackPanel>
        				</Border>
        				</Grid>
        		</StackPanel>
        		</ScrollViewer>
          <Grid x:Name="FailureAnalysisRightColumn" Grid.Column="1" Margin="8,0,0,0" MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
        			   <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0" CornerRadius="0" Padding="14">
                           <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
        
        					  <TextBlock Grid.Row="0" Text="Статистика" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        						<TextBlock Grid.Row="0" Text="Сводка выбранного оборудования и дня" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,22,0,0" />
        
        						<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        							<Border Grid.Column="0" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" HorizontalAlignment="Stretch" MinWidth="120">
        								<StackPanel>
        									<TextBlock Text="Оборудование" FontSize="12" Foreground="{StaticResource AccentForeground}" />
        									<TextBlock Text="{Binding SelectedEquipment.Title}" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
        									<TextBlock Text="{Binding SelectedEquipment.InventoryNumber}" FontSize="12" Foreground="#666" />
        								</StackPanel>
        							</Border>
        							<Border Grid.Column="1" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Width="120" Margin="8,0,0,0">
        								<StackPanel>
        									<TextBlock Text="Дата" FontSize="12" Foreground="{StaticResource AccentForeground}" />
        									<TextBlock Text="{Binding AnalysisDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontWeight="Bold" />
        								</StackPanel>
        							</Border>
        						</Grid>
        
        						<Border Grid.Row="2" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
        							<StackPanel Spacing="8">
        								<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="6">
        									<Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        										<StackPanel>
        											<TextBlock Text="Ремонты" FontSize="11" Foreground="{StaticResource TextMuted}" />
        											<TextBlock Text="{Binding SelectedDayRepairs, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        										</StackPanel>
        									</Border>
        									<Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        										<StackPanel>
        											<TextBlock Text="Настройки" FontSize="11" Foreground="{StaticResource TextMuted}" />
        											<TextBlock Text="{Binding SelectedDaySetups, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        										</StackPanel>
        									</Border>
        									<Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        										<StackPanel>
        											<TextBlock Text="Работа" FontSize="11" Foreground="{StaticResource TextMuted}" />
        											<TextBlock Text="{Binding WorkPercent, StringFormat='{}{0:0.0}%'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SuccessStrongBrush}" />
        										</StackPanel>
        									</Border>
        									<Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        										<StackPanel>
        											<TextBlock Text="Ср. ремонт" FontSize="11" Foreground="{StaticResource TextMuted}" />
        											<TextBlock Text="{Binding AvgRepairTime}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        										</StackPanel>
        									</Border>
        								</Grid>
                                     <StackPanel Orientation="Horizontal" Spacing="10">
        									<TextBlock Text="{Binding RepairsLastMonth, StringFormat='Ремонтов за 30 дн.: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" />
        									<TextBlock Text="{Binding SetupsLastMonth, StringFormat='Настроек: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" />
        								</StackPanel>
        								<ProgressBar Value="{Binding WorkPercent}" Maximum="100" Minimum="0" Height="8" />
        							</StackPanel>
        						</Border>
        
        						<Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="8" BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="1" VerticalAlignment="Stretch">
        							<Grid RowDefinitions="Auto,Auto,*">
                                        <TextBlock Grid.Row="0" Text="События за день" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                                       <Grid Grid.Row="1" ColumnDefinitions="2.4*,1.5*,1*" Margin="4,2,4,6">
        									<TextBlock Grid.Column="0" Text="Событие" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondary}" />
        									<TextBlock Grid.Column="1" Text="Ответственный" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondary}" />
        									<TextBlock Grid.Column="2" Text="Время" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
        								</Grid>
        								<Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{StaticResource RowDividerBrush}" Margin="0,0,0,2" />
        								<ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        									<ItemsControl ItemsSource="{Binding Annotations}">
        										<ItemsControl.ItemsPanel>
        											<ItemsPanelTemplate>
        												<StackPanel />
        											</ItemsPanelTemplate>
        										</ItemsControl.ItemsPanel>
        										<ItemsControl.ItemTemplate>
        											<DataTemplate>
                                                        <Grid ColumnDefinitions="2.4*,1.5*,1*" Margin="4,3">
        													<TextBlock Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="12" Foreground="{StaticResource TextSecondary}" />
        													<TextBlock Grid.Column="1" Text="{Binding Responsible}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,6,0" />
        													<TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" />
        												</Grid>
        											</DataTemplate>
        										</ItemsControl.ItemTemplate>
        									</ItemsControl>
        								</ScrollViewer>
        							</Grid>
        						</Border>
        					</Grid>
        				</Border>
         </Grid>
        
    </Grid>
</UserControl>
