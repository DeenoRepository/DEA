<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EquipmentFailureAnalysis.Views"
             x:Class="EquipmentFailureAnalysis.Views.DashboardView">
    
    <UserControl.Styles>
        <Style Selector="TabControl.dashboardTabs">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabControl.dashboardTabs TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style Selector="TabControl.dashboardTabs TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TabControl.dashboardTabs TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="DashboardLayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>
        
        <ScrollViewer x:Name="DashboardCenterColumn" Grid.Column="0" Margin="12,12,6,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
                <!-- Filter Section -->
                <Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Фильтр" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            <Border Width="1" Background="{DynamicResource RowDividerBrush}" Height="16" VerticalAlignment="Center" Margin="4,0" />
                            <TextBlock Text="Группа:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DashboardSubdivisionFilters}"
                                  SelectedItem="{Binding SelectedDashboardSubdivisionFilter, Mode=TwoWay}"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderBrush="{DynamicResource ControlBorderBrush}"
                                  BorderThickness="1"
                                  Height="30"
                                  HorizontalAlignment="Left"
                                  Width="220" />
                        
                        <Button Grid.Column="3"
                                Classes="resetFilter"
                                Content="Сброс"
                                Height="30"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                Command="{Binding ResetDashboardFiltersCommand}" />
                    </Grid>
                </Border>

                <!-- KPI Status Bar -->
                <Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*,Auto,*,Auto,*" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="События за 30 дн." FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding DashboardCurrentPeriodIssues}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding DashboardIssuesTrendText}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                        
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource RowDividerBrush}" Height="30" Margin="8,0" />
                        
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Предыдущие 30 дн." FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding DashboardPreviousPeriodIssues}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding DashboardIssuesTrendPercent, StringFormat='Δ {0:+0.0;-0.0;0}%'}" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                        
                        <Border Grid.Column="3" Width="1" Background="{DynamicResource RowDividerBrush}" Height="30" Margin="8,0" />
                        
                        <StackPanel Grid.Column="4" Spacing="2">
                            <TextBlock Text="Активное оборуд." FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding DashboardCurrentPeriodAffectedEquipment, StringFormat='{}{0} ед.'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding DashboardEquipmentInSystemCount, StringFormat='В системе: {0}'}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                        
                        <Border Grid.Column="5" Width="1" Background="{DynamicResource RowDividerBrush}" Height="30" Margin="8,0" />
                        
                        <StackPanel Grid.Column="6" Spacing="2">
                            <TextBlock Text="Средняя длит." FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding DashboardCurrentPeriodAvgDuration}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="на одно событие" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                        
                        <Border Grid.Column="7" Width="1" Background="{DynamicResource RowDividerBrush}" Height="30" Margin="8,0" />
                        
                        <StackPanel Grid.Column="8" Spacing="2">
                            <TextBlock Text="MTBF (наработка)" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding DashboardCurrentPeriodMtbf}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="на ед. оборудования" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                        
                        <Border Grid.Column="9" Width="1" Background="{DynamicResource RowDividerBrush}" Height="30" Margin="8,0" />
                        
                        <StackPanel Grid.Column="10" Spacing="2">
                            <TextBlock Text="MTTR (восстановл.)" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding DashboardCurrentPeriodMttr}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="среднее по ремонтам" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Main Grid: Charts side by side -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,2,0,0">
                    <!-- Left: Trends Chart (with TabControl switcher) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Динамика показателей" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TabControl Classes="dashboardTabs" Margin="0,2,0,0">
                                <TabItem Header="События">
                                    <views:MonthlyTrendsChartControl Items="{Binding DashboardMonthlyTrends}" Height="210" />
                                </TabItem>
                                <TabItem Header="SLA">
                                    <views:MonthlyTrendsChartControl Items="{Binding DashboardMonthlyTrends}" IsSlaChart="True" Height="210" />
                                </TabItem>
                                <TabItem Header="MTTR (ремонты)">
                                    <views:MonthlyTrendsChartControl Items="{Binding DashboardMonthlyTrends}" IsMttrChart="True" Height="210" />
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>
                    
                    <!-- Right: Pareto Chart -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Диаграмма Парето" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Критическое оборудование по числу сбоев (принцип 80/20)" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <views:ParetoChartControl Items="{Binding DashboardParetoPoints}" Height="238" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Month Statistics Table -->
                <Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Сводные данные по месяцам" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="1.5*,*,*,*,*" Margin="4,0">
                                    <TextBlock Grid.Column="0" Text="Месяц" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="Всего событий" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Из них ремонтов" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Настроек" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Ср. время устранения" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding DashboardMonthlyTrends}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="4,5">
                                                <Grid ColumnDefinitions="1.5*,*,*,*,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding PeriodLabel}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding IssuesCount}" FontSize="12" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="{Binding RepairsCount}" FontSize="12" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SetupsCount}" FontSize="12" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="{Binding AvgDurationText}" FontSize="12" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Right Column: Scrolling widget list -->
        <ScrollViewer x:Name="DashboardRightColumn" Grid.Column="1" Margin="8,12,12,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <!-- Card 1: Team performance Metrics -->
                <Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Командная эффективность" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10" Margin="0,4,0,0">
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Исполнители" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding DashboardCurrentPeriodActiveEmployees, StringFormat='{}{0} чел.'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="SLA за период" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding DashboardCurrentPeriodSlaCompliancePercent, StringFormat='{}{0:0.0}%'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="MTTR ремонта" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding DashboardCurrentPeriodMttr}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Качество учета" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding DashboardCurrentPeriodUnassignedSharePercent, StringFormat='Без отв.: {0:0.#}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="Лучший исполнитель" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding DashboardTopPerformer}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        
                        <Border Background="{DynamicResource RowDividerBrush}" Height="1" Margin="0,4" />
                        
                        <StackPanel Spacing="2">
                            <TextBlock Text="Зона особого внимания" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding DashboardRiskEquipment}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DashboardRiskEquipmentValue}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Card 2: Subdivision ratings list -->
                <Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Рейтинг подразделений" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <ItemsControl ItemsSource="{Binding DashboardSubdivisionRatings}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Subdivision}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding IssuesCount, StringFormat='Ремонты: {0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PerformanceScore, StringFormat='Рейтинг: {0:0.#}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentForeground}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding SlaCompliancePercent, StringFormat='SLA {0:0.#}%'}" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <!-- Card 3: Data warnings list -->
                <Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Диагностика данных" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <ItemsControl ItemsSource="{Binding DashboardDataWarnings}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding EquipmentTitle}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Padding="4,2" CornerRadius="4" Background="#FEE2E2">
                                                <TextBlock Text="{Binding JiraIssueKey}" FontSize="10" FontWeight="Bold" Foreground="#991B1B" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
