<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EquipmentFailureAnalysis.Views"
             x:Class="EquipmentFailureAnalysis.Views.DashboardView">

    <Grid x:Name="DashboardLayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" />
            <ColumnDefinition Width="*" MinWidth="320" MaxWidth="480" />
        </Grid.ColumnDefinitions>

        <!-- ====================================================
             CENTER COLUMN — KPI / charts / monthly table
             ==================================================== -->
        <ScrollViewer x:Name="DashboardCenterColumn"
                      Grid.Column="0"
                      Margin="20,18,16,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- ============== PAGE HEADER ============== -->
                <Grid VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Панель управления" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Сводные показатели за последние 30 дней"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Grid>

                <!-- ============== FILTER BAR ============== -->
                <Border Classes="panelFlat" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,Auto,260,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <Border Grid.Column="0"
                                Width="32" Height="32"
                                CornerRadius="8"
                                Background="{DynamicResource AccentSoftBackground}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentForeground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center" Margin="4,0,8,0">
                            <TextBlock Text="Фильтрация" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Подразделение" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding DashboardSubdivisionFilters}"
                                  SelectedItem="{Binding SelectedDashboardSubdivisionFilter, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />

                        <Border Grid.Column="3" />

                        <Button Grid.Column="4"
                                Classes="resetFilter"
                                Content="Сбросить"
                                Command="{Binding ResetDashboardFiltersCommand}"
                                Click="ResetFiltersWithToast_Click" />
                    </Grid>
                </Border>

                <!-- ============== KPI GRID (3×2) ============== -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="12" ColumnSpacing="12">

                    <!-- Events 30d -->
                    <Border Grid.Row="0" Grid.Column="0" Classes="kpi">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="События за 30 дн."
                                           Classes="cardSubtext" />
                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBackground}">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource AccentForeground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DashboardCurrentPeriodIssues}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding DashboardIssuesTrendText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentForeground}" />
                        </StackPanel>
                    </Border>

                    <!-- Prev 30d -->
                    <Border Grid.Row="0" Grid.Column="1" Classes="kpi">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Предыдущий период"
                                           Classes="cardSubtext" />
                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource WarningSoftBackground}">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DashboardPreviousPeriodIssues}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding DashboardIssuesTrendPercent, StringFormat='Δ {0:+0.0;-0.0;0}%'}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Equipment -->
                    <Border Grid.Row="0" Grid.Column="2" Classes="kpi">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Активное оборудование"
                                           Classes="cardSubtext" />
                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource InfoSoftBackground}">
                                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource InfoBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DashboardCurrentPeriodAffectedEquipment, StringFormat='{}{0} ед.'}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding DashboardEquipmentInSystemCount, StringFormat='В системе: {0}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>

                    <!-- Avg Duration -->
                    <Border Grid.Row="1" Grid.Column="0" Classes="kpi">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Средняя длительность"
                                           Classes="cardSubtext" />
                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource SurfaceAlt}">
                                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DashboardCurrentPeriodAvgDuration}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="на одно событие" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>

                    <!-- MTBF -->
                    <Border Grid.Row="1" Grid.Column="1" Classes="kpi">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="MTBF · наработка на отказ"
                                           Classes="cardSubtext" />
                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource SuccessSoftBackground}">
                                    <TextBlock Text="&#xE9F3;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DashboardCurrentPeriodMtbf}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="на единицу оборудования" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>

                    <!-- MTTR -->
                    <Border Grid.Row="1" Grid.Column="2" Classes="kpi">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="MTTR · время восстановл."
                                           Classes="cardSubtext" />
                                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource DangerSoftBackground}">
                                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource DangerBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DashboardCurrentPeriodMttr}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="среднее по ремонтам" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============== TRENDS CARD ============== -->
                <Border Classes="panel">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Тренды показателей" Classes="sectionTitle" />
                                <TextBlock Text="Динамика событий, SLA и MTTR по месяцам"
                                           Classes="sectionSubtitle" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource AccentSoftBackground}"
                                    BorderBrush="{DynamicResource AccentSoftBorder}"
                                    BorderThickness="1" CornerRadius="999" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Пик" FontSize="11" Foreground="{DynamicResource AccentForeground}" />
                                    <TextBlock Text="{Binding DashboardMaxIssuesInMonth}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentForeground}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource SuccessSoftBackground}"
                                    BorderBrush="{DynamicResource SuccessSoftBorder}"
                                    BorderThickness="1" CornerRadius="999" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="SLA" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="{Binding DashboardCurrentPeriodSlaCompliancePercent, StringFormat='{}{0:0.#}%'}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <!-- Events -->
                            <Border Grid.Column="0" Classes="well">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#10B981" />
                                        <TextBlock Text="События" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <views:MonthlyTrendsChartControl Items="{Binding DashboardMonthlyTrends}" Height="150" />
                                </StackPanel>
                            </Border>

                            <!-- SLA -->
                            <Border Grid.Column="1" Classes="well">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#3B82F6" />
                                        <TextBlock Text="SLA" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <views:MonthlyTrendsChartControl Items="{Binding DashboardMonthlyTrends}" IsSlaChart="True" Height="150" />
                                </StackPanel>
                            </Border>

                            <!-- MTTR -->
                            <Border Grid.Column="2" Classes="well">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#EF4444" />
                                        <TextBlock Text="MTTR" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <views:MonthlyTrendsChartControl Items="{Binding DashboardMonthlyTrends}" IsMttrChart="True" Height="150" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============== PARETO ============== -->
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Диаграмма Парето" Classes="sectionTitle" />
                            <TextBlock Text="Распределение событий по оборудованию"
                                       Classes="sectionSubtitle" />
                        </StackPanel>
                        <Border Classes="well" Padding="14,12">
                            <views:ParetoChartControl Items="{Binding DashboardParetoPoints}" Height="220" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============== MONTHLY TABLE ============== -->
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Сводные данные по месяцам" Classes="sectionTitle" />
                            <TextBlock Text="Полная статистика по событиям и времени устранения"
                                       Classes="sectionSubtitle" />
                        </StackPanel>

                        <Border Classes="well" Padding="0">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Sticky header row -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0"
                                        Padding="14,10">
                                    <Grid ColumnDefinitions="1.5*,*,*,*,*">
                                        <TextBlock Grid.Column="0" Text="Месяц"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="События"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Ремонтов"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="Настроек"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="Ср. время"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <!-- Scrollable list body -->
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="320">
                                    <ItemsControl ItemsSource="{Binding DashboardMonthlyTrends}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource RowDividerBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="14,9">
                                                    <Grid ColumnDefinitions="1.5*,*,*,*,*">
                                                        <TextBlock Grid.Column="0" Text="{Binding PeriodLabel}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondary}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding IssuesCount}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="2" Text="{Binding RepairsCount}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{Binding SetupsCount}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{Binding AvgDurationText}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ====================================================
             RIGHT COLUMN — Team & subdivisions
             ==================================================== -->
        <Grid x:Name="DashboardRightColumn" Grid.Column="1"
              MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">

                        <!-- Section header -->
                        <StackPanel Spacing="2">
                            <TextBlock Classes="eyebrow" Text="ОБЗОР · 30 ДНЕЙ" />
                            <TextBlock Text="Командная эффективность" Classes="sectionTitle" />
                            <TextBlock Text="Сводные показатели по людям, SLA и качеству учёта"
                                       Classes="sectionSubtitle" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Team KPI mini grid -->
                        <Border Classes="well">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="14" ColumnSpacing="14">

                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Исполнители" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding DashboardCurrentPeriodActiveEmployees, StringFormat='{}{0} чел.'}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="SLA соблюдено" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding DashboardCurrentPeriodSlaCompliancePercent, StringFormat='{}{0:0.0}%'}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="MTTR ремонта" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding DashboardCurrentPeriodMttr}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Без ответств." FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding DashboardCurrentPeriodUnassignedSharePercent, StringFormat='{}{0:0.#}%'}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Top performer card -->
                        <Border Background="{DynamicResource SuccessSoftBackground}"
                                BorderBrush="{DynamicResource SuccessSoftBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6"
                                            Background="{DynamicResource SuccessBrush}">
                                        <TextBlock Text="&#xEA86;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Лучший исполнитель" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DashboardTopPerformer}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Нет данных"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{DynamicResource TextMuted}"
                                           IsVisible="{Binding DashboardTopPerformer, Converter={StaticResource IsEmptyConverter}}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Risk equipment card -->
                        <Border Background="{DynamicResource DangerSoftBackground}"
                                BorderBrush="{DynamicResource DangerSoftBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="6"
                                            Background="{DynamicResource DangerBrush}">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Зона особого внимания" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DashboardRiskEquipment}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Нет проблемного оборудования"
                                           FontSize="12" FontStyle="Italic"
                                           Foreground="{DynamicResource TextMuted}"
                                           IsVisible="{Binding DashboardRiskEquipment, Converter={StaticResource IsEmptyConverter}}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DashboardRiskEquipmentValue}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                        </Border>

                        <!-- Subdivision ratings -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Рейтинг подразделений" Classes="sectionTitle"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="ghost" Padding="8,2" FontSize="10"
                                        IsVisible="{Binding SubdivisionRatingsCollapsed, Converter={StaticResource InvertBoolConverter}}"
                                        Content="Свернуть"
                                        Click="ShowAllSubdivisionsToggle_Click" />
                            </Grid>
                            <Border Classes="emptyState"
                                    IsVisible="{Binding DashboardSubdivisionRatings, Converter={StaticResource IsEmptyConverter}}">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="10"
                                            Background="{DynamicResource AccentSoftBackground}">
                                        <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentForeground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Classes="emptyStateSubtitle" Text="Нет данных по подразделениям"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding VisibleSubdivisionRatings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource RowDividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Subdivision}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding IssuesCount, StringFormat='Ремонты: {0}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding PerformanceScore, StringFormat='{}{0:0.#}'}"
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentForeground}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding SlaCompliancePercent, StringFormat='SLA {0:0.#}%'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="soft" HorizontalAlignment="Stretch" Padding="10,6"
                                    IsVisible="{Binding SubdivisionRatingsShowAllVisible}"
                                    Content="Показать все"
                                    Click="ShowAllSubdivisionsToggle_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
