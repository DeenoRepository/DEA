<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EquipmentFailureAnalysis.Views.LdapConnectionSettingsWindow"
        Width="500"
        Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Title="Параметры LDAP">
  <Border Padding="16">
    <StackPanel Spacing="10">
      <TextBlock Text="Параметры LDAP подключения" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Укажите параметры сервера для проверки учетных данных."
                 FontSize="12"
                 Opacity="0.8"
                 TextWrapping="Wrap" />

      <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="LDAP сервер" />
          <TextBox x:Name="ServerBox" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Порт" />
          <NumericUpDown x:Name="PortBox" Minimum="1" Maximum="65535" Increment="1" FormatString="F0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
          <TextBlock Text=" " />
          <CheckBox x:Name="UseSslBox" Content="SSL (LDAPS)" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Домен (опционально)" />
          <TextBox x:Name="DomainBox" Watermark="company.local" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Base DN (опционально)" />
          <TextBox x:Name="BaseDnBox" Watermark="DC=company,DC=local" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
        <TextBlock Grid.Column="0"
                   Text="Настройки применяются в этом окне входа и сохраняются после успешного входа."
                   FontSize="11"
                   Opacity="0.75"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Отмена" MinWidth="90" Click="CancelButton_Click" />
        <Button Grid.Column="2" Content="Применить" MinWidth="90" Click="ApplyButton_Click" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
