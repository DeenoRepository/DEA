<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EquipmentFailureAnalysis.Views.LdapLoginWindow"
        Width="460"
        Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Title="LDAP Авторизация"
        Background="{DynamicResource PrimaryBackground}">



    <Border Padding="24">
        <StackPanel Spacing="16">

            <!-- Header -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{DynamicResource AccentSoftBackground}">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="Вход в систему"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="ServerText"
                                   Text="LDAP"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource RowDividerBrush}" />

            <!-- Username -->
            <StackPanel Spacing="6">
                <TextBlock Text="Логин" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}" />
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, Mode=TwoWay}"
                         Watermark="domain\user или user@domain" />
            </StackPanel>

            <!-- Password -->
            <StackPanel Spacing="6">
                <TextBlock Text="Пароль" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox x:Name="PasswordBox"
                             Grid.Column="0"
                             Text="{Binding Password, Mode=TwoWay}"
                             PasswordChar="*" />
                    <Button Grid.Column="1" Classes="smallIcon" Width="34" Height="34"
                            ToolTip.Tip="Показать/скрыть пароль"
                            Click="TogglePasswordVisibility_Click">
                        <TextBlock x:Name="PasswordRevealGlyph"
                                   Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Error -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsVisible="False" x:Name="ErrorPanel">
                <Border Width="18" Height="18" CornerRadius="9"
                        Background="{DynamicResource DangerBrush}">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="ErrorText"
                           IsVisible="False"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Actions -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Classes="smallIcon"
                        ToolTip.Tip="Настройки LDAP"
                        Click="SettingsButton_Click">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button Grid.Column="2"
                        Content="Отмена"
                        MinWidth="90"
                        Click="CancelButton_Click" />
                <Button Grid.Column="3"
                        Classes="primary"
                        Content="Войти"
                        MinWidth="100"
                        Click="SignInButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
