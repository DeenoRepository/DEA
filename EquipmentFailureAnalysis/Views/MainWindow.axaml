<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:EquipmentFailureAnalysis.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:effects="clr-namespace:Avalonia.Media.Effects;assembly=Avalonia.Visuals"
		xmlns:utility="using:EquipmentFailureAnalysis.Utility"
		xmlns:views="using:EquipmentFailureAnalysis.Views"
		mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
     x:Class="EquipmentFailureAnalysis.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
		Title="DEA - Equipment Failure Analysis"
		Background="{StaticResource PrimaryBackground}"
		WindowState="Maximized">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainWindowViewModel/>
	</Design.DataContext>

    <Window.Resources>
     <utility:ValueToColorConverter x:Key="ColorConverter"/>
        <utility:DayCellToBrushConverter x:Key="DayCellConverter" />
        <utility:RepairsToBrushConverter x:Key="RepairsToBrushConverter" />
        <utility:RepairsToStatusConverter x:Key="RepairsToStatusConverter" />
        <utility:RepairsToForegroundConverter x:Key="RepairsToForegroundConverter" />
		<utility:BinaryToBrushConverter x:Key="BinaryConverter"/>
		<utility:StatusToBrushConverter x:Key="StatusToBrush" />
		<utility:SelectedToBackgroundConverter x:Key="SelectedToBackground" />
		<utility:IndexToForegroundConverter x:Key="IndexToForegroundConverter" />

        <!-- Typography / card styles using class selectors -->
		<FontFamily x:Key="AppFont">Segoe UI</FontFamily>
        <Style x:Key="HeaderTitleStyle" Selector="TextBlock.headerTitle">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="30" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="#FFFFFF" />
			<Setter Property="Margin" Value="0,0,0,0" />
		</Style>
        <Style x:Key="SectionTitleStyle" Selector="TextBlock.sectionTitle">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>
        <Style x:Key="CardTitleStyle" Selector="TextBlock.cardTitle">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>
        <Style x:Key="CardValueStyle" Selector="TextBlock.cardValue">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="20" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>
        <Style x:Key="CardSubtextStyle" Selector="TextBlock.cardSubtext">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="#666" />
		</Style>

		<!-- Button tweaks -->
        <Style x:Key="IconButtonStyle" Selector="Button.smallIcon">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="28" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style x:Key="DateShiftButtonStyle" Selector="Button.dateShift">
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Background" Value="#EEF4FF" />
			<Setter Property="BorderBrush" Value="#C7D7F7" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Foreground" Value="#1D4ED8" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style x:Key="ResetFilterButtonStyle" Selector="Button.resetFilter">
			<Setter Property="MinWidth" Value="86" />
			<Setter Property="Padding" Value="12,6" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Background" Value="#EEF4FF" />
			<Setter Property="BorderBrush" Value="#C7D7F7" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Foreground" Value="#1D4ED8" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>

		<!-- Legend brushes for heatmap (brighter stops) -->
		<SolidColorBrush x:Key="HeatmapGreen" Color="#81C784" />
		<SolidColorBrush x:Key="HeatmapYellow" Color="#FFEE58" />
		<SolidColorBrush x:Key="HeatmapOrange" Color="#FFB74D" />
		<SolidColorBrush x:Key="HeatmapRed" Color="#EF5350" />

        <!-- Palette -->
	   <SolidColorBrush x:Key="PrimaryBackground" Color="#F1F4F8" />
		<SolidColorBrush x:Key="HeaderBackground" Color="#234465" />
		<SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
		<SolidColorBrush x:Key="AccentBrush" Color="#1976D2" />
		<SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
     <SolidColorBrush x:Key="TextPrimary" Color="#1F2937" />

		<!-- Styles -->
        <Style x:Key="SidebarButtonStyle" Selector="Button">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="#E0E0E0" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>

        <Style x:Key="DayButtonStyle" Selector="Button.Day">
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="BorderBrush" Value="#CFCFCF" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>

    </Window.Resources>

	<Window.Styles>
		<!-- Implicit style to completely hide ScrollBar visuals while keeping scrolling behavior -->
		<Style Selector="ScrollBar">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="Transparent" Width="0" Height="0" />
				</ControlTemplate>
			</Setter>
		</Style>
	</Window.Styles>

	<Grid>
        <Grid.ColumnDefinitions>
			<!-- Use star sizing so layout adapts when window is resized -->
         <ColumnDefinition Width="240" />
			<ColumnDefinition Width="7*" />
          <ColumnDefinition Width="1.9*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

 <!-- Top header -->
  <Border Grid.ColumnSpan="3" Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="12" CornerRadius="0" Margin="0">
		<Grid VerticalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
				<Image Source="/Assets/avalonia-logo.ico" Width="44" Height="44" />
				<StackPanel Orientation="Vertical" VerticalAlignment="Center">
					<TextBlock Classes="headerTitle" Text="Анализ неисправностей оборудования" Foreground="#E8F3FF" />
					<TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="#E8F3FF">Мониторинг рабочих смен и простоев</TextBlock>
				</StackPanel>
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
			</StackPanel>
		</Grid>
	</Border>

    <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,12,0" MinWidth="140" MaxWidth="260" HorizontalAlignment="Stretch">
           <Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="12">
                <StackPanel Spacing="10">
					<TextBlock Text="Навигация" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
					<TextBlock Text="Быстрый доступ к разделам приложения" FontSize="12" Foreground="#6B7280" Margin="0,-2,0,2" TextWrapping="Wrap" />

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="4">
						<Button HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8" Click="DashboardButton_Click">
							<StackPanel Spacing="2" HorizontalAlignment="Left">
                               <TextBlock Text="Панель управления" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
								<TextBlock Text="Общие тренды по работам, простоям и эффективности сотрудников" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
							</StackPanel>
						</Button>
					</Border>

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="4">
                     <Button HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8" Click="DowntimeAnalysisButton_Click">
							<StackPanel Spacing="2" HorizontalAlignment="Left">
                             <TextBlock Text="Анализ простоев" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
								<TextBlock Text="Карта тепла, перечень оборудования с фиксацей простоев за день" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
							</StackPanel>
						</Button>
					</Border>

                    <Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="4">
                     <Button HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8" Click="EmployeeAnalysisButton_Click">
							<StackPanel Spacing="2" HorizontalAlignment="Left">
                                <TextBlock Text="Анализ сотрудников" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
								<TextBlock Text="Эффективность, длительность работ и активность ответственных" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
							</StackPanel>
						</Button>
					</Border>

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="4">
                        <Button HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8" Click="SettingsButton_Click">
							<StackPanel Spacing="2" HorizontalAlignment="Left">
                                <TextBlock Text="Настройки" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
								<TextBlock Text="Параметры отображения и конфигурация приложения" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
							</StackPanel>
						</Button>
					</Border>
				</StackPanel>
			</Border>
		</Grid>
  <Grid x:Name="DashboardPage" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="8,0,0,0" IsVisible="False">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="7*" />
			<ColumnDefinition Width="1.9*" />
		</Grid.ColumnDefinitions>

		<ScrollViewer Grid.Column="0" Margin="0,12,8,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
			<StackPanel Spacing="10">
				<Grid>
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardxmlBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
						<StackPanel>
                          <TextBlock Text="Состояние работ" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<TextBlock Text="Показывает текущую интенсивность работ и ключевые изменения относительно предыдущего периода" FontSize="12" Foreground="#6B7280" Margin="0,2,0,10" TextWrapping="Wrap" />

							<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
								<Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
									<StackPanel>
										<TextBlock Text="События за 30 дн." FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DashboardCurrentPeriodIssues, StringFormat='{}{0}'}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
										<TextBlock Text="{Binding DashboardIssuesTrendText}" FontSize="11" Foreground="#2563EB" />
									</StackPanel>
								</Border>
								<Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
									<StackPanel>
										<TextBlock Text="Предыдущие 30 дн." FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DashboardPreviousPeriodIssues, StringFormat='{}{0}'}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
										<TextBlock Text="{Binding DashboardIssuesTrendPercent, StringFormat='Δ {0:+0.0;-0.0;0}%'}" FontSize="11" Foreground="#B45309" />
									</StackPanel>
								</Border>
								<Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
									<StackPanel>
										<TextBlock Text="Активное оборудование" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DashboardCurrentPeriodAffectedEquipment, StringFormat='{}{0} ед.'}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
										<TextBlock Text="{Binding EquipmentCollection.Count, StringFormat='В системе: {0}'}" FontSize="11" Foreground="#6B7280" />
									</StackPanel>
								</Border>
								<Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
									<StackPanel>
										<TextBlock Text="Средняя длительность" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DashboardCurrentPeriodAvgDuration}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
										<TextBlock Text="на одно событие" FontSize="11" Foreground="#6B7280" />
									</StackPanel>
								</Border>
							</Grid>
						</StackPanel>
					</Border>
				</Grid>


              <Grid Margin="0,0,0,8">
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
						<StackPanel Spacing="8">
							<TextBlock Text="Тренды по месяцам" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<TextBlock Text="Динамика нагрузки и качества выполнения по последним месяцам" FontSize="12" Foreground="#6B7280" />

							<Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
								<Border Grid.Column="0" Background="#EEF4FF" BorderBrush="#D9E7FF" BorderThickness="1" CornerRadius="0" Padding="8,4">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="Пик:" FontSize="11" Foreground="#4B5563" />
										<TextBlock Text="{Binding DashboardMaxIssuesInMonth}" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" />
									</StackPanel>
								</Border>
								<Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#CFF4E1" BorderThickness="1" CornerRadius="0" Padding="8,4">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="SLA:" FontSize="11" Foreground="#4B5563" />
										<TextBlock Text="{Binding DashboardCurrentPeriodSlaCompliancePercent, StringFormat='{}{0:0.#}%'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F766E" />
									</StackPanel>
								</Border>
							</Grid>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
								<Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
									<StackPanel Spacing="4">
										<TextBlock Text="События" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
										<ItemsControl ItemsSource="{Binding DashboardMonthlyTrends}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
                                                  <Grid ColumnDefinitions="1.2*,3*,56" ColumnSpacing="6" Margin="0,1">
														<TextBlock Grid.Column="0" Text="{Binding PeriodLabel}" FontSize="11" Foreground="#4B5563" VerticalAlignment="Center" />
														<ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding DataContext.DashboardMaxIssuesInMonth, RelativeSource={RelativeSource AncestorType=Window}}" Value="{Binding IssuesCount}" Height="7" VerticalAlignment="Center" />
                                                      <TextBlock Grid.Column="2" Text="{Binding IssuesCount}" FontSize="11" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>

								<Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
									<StackPanel Spacing="4">
										<TextBlock Text="SLA" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
										<ItemsControl ItemsSource="{Binding DashboardMonthlyTrends}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
                                                  <Grid ColumnDefinitions="1.2*,3*,68" ColumnSpacing="6" Margin="0,1">
														<TextBlock Grid.Column="0" Text="{Binding PeriodLabel}" FontSize="11" Foreground="#4B5563" VerticalAlignment="Center" />
														<ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SlaCompliancePercent}" Height="7" VerticalAlignment="Center" />
                                                      <TextBlock Grid.Column="2" Text="{Binding SlaCompliancePercent, StringFormat='{}{0:0.#}%'}" FontSize="11" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" />
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>
							</Grid>

							<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
								<StackPanel Spacing="3">
									<Grid ColumnDefinitions="1.2*,0.8*,0.8*,0.8*,*" Margin="2,0">
										<TextBlock Grid.Column="0" Text="Месяц" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
										<TextBlock Grid.Column="1" Text="Соб." FontSize="12" FontWeight="SemiBold" Foreground="#374151" HorizontalAlignment="Right" />
										<TextBlock Grid.Column="2" Text="Рем." FontSize="12" FontWeight="SemiBold" Foreground="#374151" HorizontalAlignment="Right" />
										<TextBlock Grid.Column="3" Text="Наст." FontSize="12" FontWeight="SemiBold" Foreground="#374151" HorizontalAlignment="Right" />
										<TextBlock Grid.Column="4" Text="Ср. время" FontSize="12" FontWeight="SemiBold" Foreground="#374151" HorizontalAlignment="Right" />
									</Grid>
									<ItemsControl ItemsSource="{Binding DashboardMonthlyTrends}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border BorderBrush="#EDF1F5" BorderThickness="0,1,0,0" Padding="2,3">
                                                    <Grid ColumnDefinitions="1.2*,0.8*,0.8*,0.8*,*">
														<TextBlock Grid.Column="0" Text="{Binding PeriodLabel}" FontSize="12" Foreground="#1F2937" />
														<TextBlock Grid.Column="1" Text="{Binding IssuesCount}" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" />
														<TextBlock Grid.Column="2" Text="{Binding RepairsCount}" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" />
														<TextBlock Grid.Column="3" Text="{Binding SetupsCount}" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" />
														<TextBlock Grid.Column="4" Text="{Binding AvgDurationText}" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" />
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
						</StackPanel>
					</Border>
				</Grid>

			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Column="1" Margin="8,0,0,0" MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
			<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
				<StackPanel Spacing="10">
					<TextBlock Text="Качество команды" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
					<TextBlock Text="Индикаторы SLA и персональной эффективности за последние 30 дней" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" />

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel>
							<TextBlock Text="Активные сотрудники" FontSize="11" Foreground="#6B7280" />
							<TextBlock Text="{Binding DashboardCurrentPeriodActiveEmployees, StringFormat='{}{0} чел.'}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
						</StackPanel>
					</Border>

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel>
							<TextBlock Text="SLA за период" FontSize="11" Foreground="#6B7280" />
							<TextBlock Text="{Binding DashboardCurrentPeriodSlaCompliancePercent, StringFormat='Соблюдение: {0:0.0}%'}" FontSize="14" FontWeight="SemiBold" Foreground="#0F766E" />
							<TextBlock Text="{Binding DashboardCurrentPeriodSlaBreaches, StringFormat='Нарушений: {0}'}" FontSize="12" Foreground="#B91C1C" />
							<ProgressBar Minimum="0" Maximum="100" Value="{Binding DashboardCurrentPeriodSlaCompliancePercent}" Height="7" Margin="0,6,0,0" />
						</StackPanel>
					</Border>

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel>
							<TextBlock Text="Лучший исполнитель" FontSize="11" Foreground="#6B7280" />
							<TextBlock Text="{Binding DashboardTopPerformer}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" />
							<TextBlock Text="{Binding DashboardTopPerformerValue}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" />
						</StackPanel>
					</Border>

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel>
							<TextBlock Text="Зона внимания" FontSize="11" Foreground="#6B7280" />
							<TextBlock Text="{Binding DashboardRiskEquipment}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" TextWrapping="WrapWithOverflow" />
							<TextBlock Text="{Binding DashboardRiskEquipmentValue}" FontSize="12" Foreground="#6B7280" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
        <!-- central column: only vertical scrolling; heatmap has its own horizontal scroller -->
        <ScrollViewer x:Name="FailureAnalysisCenterColumn" Grid.Column="1" Grid.Row="1" Margin="8,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Spacing="10">
                <!-- Top header showing day numbers moved into heatmap block for alignment -->

              <Grid>
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
						<StackPanel Spacing="8">
							<TextBlock Text="Универсальный фильтр" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<TextBlock Text="Фильтрация по типу неисправности, ответственному и оборудованию" FontSize="12" Foreground="#6B7280" />
                            <Grid ColumnDefinitions="Auto,170,Auto,220,Auto,220,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
								<TextBlock Grid.Column="0" Text="Тип:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<ComboBox Grid.Column="1"
									ItemsSource="{Binding DowntimeIssueTypeFilters}"
									SelectedItem="{Binding SelectedDowntimeIssueTypeFilter, Mode=TwoWay}"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
								<TextBlock Grid.Column="2" Text="Ответственный:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<ComboBox Grid.Column="3"
									ItemsSource="{Binding DowntimeResponsibleFilters}"
									SelectedItem="{Binding SelectedDowntimeResponsibleFilter, Mode=TwoWay}"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
                                <TextBlock Grid.Column="4" Text="Группа:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<ComboBox Grid.Column="5"
									ItemsSource="{Binding DowntimeSubdivisionFilters}"
									SelectedItem="{Binding SelectedDowntimeSubdivisionFilter, Mode=TwoWay}"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
								<TextBlock Grid.Column="6" Text="Оборудование:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<TextBox Grid.Column="7"
									Watermark="Поиск по названию или инв. номеру"
									Text="{Binding DowntimeEquipmentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
                             <Button Grid.Column="8"
                                 Classes="resetFilter"
									Content="Сброс"
									Command="{Binding ResetUniversalFiltersCommand}" />
							</Grid>
						</StackPanel>
					</Border>
				</Grid>

                <Grid>
                 <Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
						<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
                  <StackPanel HorizontalAlignment="Stretch">
						<TextBlock Text="Карта тепла" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
						<TextBlock Text="Ежедневная интенсивность неисправностей по месяцам" FontSize="12" Foreground="#6B7280" Margin="0,0,0,8" />
						<Grid>
							<!-- single scroll area that contains both day headers and month rows so they scroll together -->
                            <ScrollViewer x:Name="HeatmapScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
								<StackPanel Margin="2">
                                    <!-- Day headers aligned with day cells (use width matching day cell width + margin) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                        <TextBlock Width="72" />
										<ItemsControl ItemsSource="{Binding DayHeaders}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
                                                <DataTemplate>
													<Border Width="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="2" Background="Transparent">
														<TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#666" />
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>

                                    <!-- Month rows -->
									<ItemsControl ItemsSource="{Binding MonthRows}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Vertical" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
													<TextBlock Text="{Binding MonthName}" Width="72" VerticalAlignment="Center" Margin="2" />
													<ItemsControl ItemsSource="{Binding Days}">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<StackPanel Orientation="Horizontal" />
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Margin="2" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"
																		Command="{Binding DataContext.ShowDayTimelineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
																		CommandParameter="{Binding Date}" IsVisible="{Binding IsValid}">
                                            <Border Width="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="0" Background="{Binding ., Converter={StaticResource DayCellConverter}, ConverterParameter=FailureAnalysis}" BorderBrush="#E6E6E6" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
																		<TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{Binding Index, Converter={StaticResource IndexToForegroundConverter}}" />
																	</Border>
                                                                <ToolTip.Tip>
																	<StackPanel>
																		<TextBlock Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}" />
																		<TextBlock Text="{Binding Index, StringFormat='Неисправностей: {0}'}" />
																	</StackPanel>
																</ToolTip.Tip>
																<Button.ContextMenu>
																	<ContextMenu>
                                                 <MenuItem Header="Показать в панели управления" Command="{Binding DataContext.LoadEquipmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.SelectedEquipment, RelativeSource={RelativeSource AncestorType=Window}}" />
																	</ContextMenu>
																</Button.ContextMenu>
																</Button>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
                                    </ItemsControl>
								</StackPanel>

							</ScrollViewer>
						</Grid>

						<!-- Heatmap legend -->
						<StackPanel Orientation="Horizontal" Margin="8,6,0,0" HorizontalAlignment="Left">
							<TextBlock Text="Легенда:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,8,0" />
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Border Width="24" Height="14" Background="{StaticResource HeatmapGreen}" CornerRadius="0" BorderBrush="#DDD" BorderThickness="1" />
								<TextBlock Text=" 0" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Border Width="24" Height="14" Background="{StaticResource HeatmapYellow}" CornerRadius="0" BorderBrush="#DDD" BorderThickness="1" />
								<TextBlock Text=" 3-6" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Border Width="24" Height="14" Background="{StaticResource HeatmapOrange}" CornerRadius="0" BorderBrush="#DDD" BorderThickness="1" />
								<TextBlock Text=" 7-9" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Border Width="24" Height="14" Background="{StaticResource HeatmapRed}" CornerRadius="0" BorderBrush="#DDD" BorderThickness="1" />
								<TextBlock Text=" 10+" VerticalAlignment="Center" Foreground="#444" Margin="6,0,0,0" />
							</StackPanel>
						</StackPanel>
                    </StackPanel>
					</Border>
				</Grid>

				<!-- Timeline panel showing 24-hour state blocks under heatmap -->
                <Grid>
                 <Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
                    <StackPanel>
						<TextBlock Text="График простоев" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
						<TextBlock Text="Динамика ремонтов и настроек в течение суток" FontSize="12" Foreground="#6B7280" Margin="0,0,0,8" />
                        <Grid>
                            <views:TimelineControl Items="{Binding DayTimelinePoints}" RepairsItems="{Binding RepairsTimelinePoints}" SetupsItems="{Binding SetupsTimelinePoints}" Annotations="{Binding Annotations}" Height="410" ShowHourLabels="True" VerticalAlignment="Top" />
							<Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Background="#CCFFFFFF" BorderBrush="#D6DEE8" BorderThickness="1" CornerRadius="0" Padding="8,6">
								<StackPanel Spacing="4">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Border Width="14" Height="3" Background="#D32F2F" VerticalAlignment="Center" />
										<TextBlock Text="Ремонт" FontSize="12" Foreground="#1F2937" VerticalAlignment="Center" />
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Border Width="14" Height="3" Background="#FBC02D" VerticalAlignment="Center" />
										<TextBlock Text="Настройка" FontSize="12" Foreground="#1F2937" VerticalAlignment="Center" />
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Border Width="14" Height="3" Background="#FF8F00" VerticalAlignment="Center" />
										<TextBlock Text="Пересечение" FontSize="12" Foreground="#1F2937" VerticalAlignment="Center" />
									</StackPanel>
								</StackPanel>
							</Border>
						</Grid>
					</StackPanel>
				</Border>
				</Grid>
		</StackPanel>
		</ScrollViewer>
   <Grid x:Name="FailureAnalysisRightColumn" Grid.Column="2" Grid.Row="1" Margin="8,0,0,0" MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
			   <Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
                   <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">

					  <TextBlock Grid.Row="0" Text="Статистика" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
						<TextBlock Grid.Row="0" Text="Сводка выбранного оборудования и дня" FontSize="12" Foreground="#6B7280" Margin="0,22,0,0" />

						<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
							<Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="12" HorizontalAlignment="Stretch" MinWidth="120">
								<StackPanel>
									<TextBlock Text="Оборудование" FontSize="12" Foreground="#1976D2" />
									<TextBlock Text="{Binding SelectedEquipment.Title}" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
									<TextBlock Text="{Binding SelectedEquipment.InventoryNumber}" FontSize="12" Foreground="#666" />
								</StackPanel>
							</Border>
							<Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="12" Width="120" Margin="8,0,0,0">
								<StackPanel>
									<TextBlock Text="Дата" FontSize="12" Foreground="#7A4BAE" />
									<TextBlock Text="{Binding AnalysisDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontWeight="Bold" />
								</StackPanel>
							</Border>
						</Grid>

						<Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="6">
									<Border Grid.Row="0" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
										<StackPanel>
											<TextBlock Text="Ремонты" FontSize="11" Foreground="#6B7280" />
											<TextBlock Text="{Binding SelectedDayRepairs, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
										</StackPanel>
									</Border>
									<Border Grid.Row="0" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
										<StackPanel>
											<TextBlock Text="Настройки" FontSize="11" Foreground="#6B7280" />
											<TextBlock Text="{Binding SelectedDaySetups, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
										</StackPanel>
									</Border>
									<Border Grid.Row="1" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
										<StackPanel>
											<TextBlock Text="Работа" FontSize="11" Foreground="#6B7280" />
											<TextBlock Text="{Binding WorkPercent, StringFormat='{}{0:0.0}%'}" FontSize="16" FontWeight="SemiBold" Foreground="#2E7D32" />
										</StackPanel>
									</Border>
									<Border Grid.Row="1" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
										<StackPanel>
											<TextBlock Text="Ср. ремонт" FontSize="11" Foreground="#6B7280" />
											<TextBlock Text="{Binding AvgRepairTime}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
										</StackPanel>
									</Border>
								</Grid>
                             <StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock Text="{Binding RepairsLastMonth, StringFormat='Ремонтов за 30 дн.: {0}'}" FontSize="11" Foreground="#6B7280" />
									<TextBlock Text="{Binding SetupsLastMonth, StringFormat='Настроек: {0}'}" FontSize="11" Foreground="#6B7280" />
								</StackPanel>
								<ProgressBar Value="{Binding WorkPercent}" Maximum="100" Minimum="0" Height="8" />
							</StackPanel>
						</Border>

						<Border Grid.Row="3" Background="#FFFFFF" CornerRadius="0" Padding="8" BorderBrush="#E6EAF0" BorderThickness="1" VerticalAlignment="Stretch">
							<Grid RowDefinitions="Auto,Auto,*">
                                <TextBlock Grid.Row="0" Text="События за день" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                               <Grid Grid.Row="1" ColumnDefinitions="2.4*,1.5*,1*" Margin="4,2,4,6">
									<TextBlock Grid.Column="0" Text="Событие" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
									<TextBlock Grid.Column="1" Text="Ответственный" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
									<TextBlock Grid.Column="2" Text="Время" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								</Grid>
								<Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="#E6EAF0" Margin="0,0,0,2" />
								<ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
									<ItemsControl ItemsSource="{Binding Annotations}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
                                                <Grid ColumnDefinitions="2.4*,1.5*,1*" Margin="4,3">
													<TextBlock Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="12" Foreground="#1F2937" />
													<TextBlock Grid.Column="1" Text="{Binding Responsible}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="12" Foreground="#4B5563" Margin="8,0,6,0" />
													<TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="#111827" />
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Grid>
						</Border>
					</Grid>
				</Border>
 </Grid>

  <Grid x:Name="DowntimeAnalysisPage" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="8,0,0,0" IsVisible="False">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="7*" />
			<ColumnDefinition Width="1.9*" />
		</Grid.ColumnDefinitions>

       <ScrollViewer Grid.Column="0" Margin="0,12,8,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
           <StackPanel Spacing="10">
            <Grid>
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
						<StackPanel Spacing="8">
							<TextBlock Text="Универсальный фильтр" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<TextBlock Text="Фильтрация по типу неисправности, ответственному и оборудованию" FontSize="12" Foreground="#6B7280" />
                            <Grid ColumnDefinitions="Auto,170,Auto,220,Auto,220,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
								<TextBlock Grid.Column="0" Text="Тип:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<ComboBox Grid.Column="1"
									ItemsSource="{Binding DowntimeIssueTypeFilters}"
									SelectedItem="{Binding SelectedDowntimeIssueTypeFilter, Mode=TwoWay}"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
								<TextBlock Grid.Column="2" Text="Ответственный:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<ComboBox Grid.Column="3"
									ItemsSource="{Binding DowntimeResponsibleFilters}"
									SelectedItem="{Binding SelectedDowntimeResponsibleFilter, Mode=TwoWay}"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
                                <TextBlock Grid.Column="4" Text="Группа:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<ComboBox Grid.Column="5"
									ItemsSource="{Binding DowntimeSubdivisionFilters}"
									SelectedItem="{Binding SelectedDowntimeSubdivisionFilter, Mode=TwoWay}"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
								<TextBlock Grid.Column="6" Text="Оборудование:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<TextBox Grid.Column="7"
									Watermark="Поиск по названию или инв. номеру"
									Text="{Binding DowntimeEquipmentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
                             <Button Grid.Column="8"
                                 Classes="resetFilter"
									Content="Сброс"
									Command="{Binding ResetUniversalFiltersCommand}" />
							</Grid>
						</StackPanel>
					</Border>
				</Grid>

             <Grid>
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
						<StackPanel HorizontalAlignment="Stretch">
							<TextBlock Text="Карта тепла" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
							<TextBlock Text="Значение ячейки: количество единиц оборудования с неисправностями за день" FontSize="12" Foreground="#6B7280" Margin="0,0,0,8" />
                          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
								<StackPanel Margin="2">
									<StackPanel Orientation="Horizontal" Margin="0,6,0,6">
										<TextBlock Width="72" />
										<ItemsControl ItemsSource="{Binding DayHeaders}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border Width="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="2" Background="Transparent">
														<TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#666" />
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>

									<ItemsControl ItemsSource="{Binding DowntimeMonthRows}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Vertical" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal" Margin="2">
													<TextBlock Text="{Binding MonthName}" Width="72" VerticalAlignment="Center" Margin="2" />
													<ItemsControl ItemsSource="{Binding Days}">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<StackPanel Orientation="Horizontal" />
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<Button Margin="2" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"
																	Command="{Binding DataContext.ShowDowntimeDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
																	CommandParameter="{Binding Date}" IsVisible="{Binding IsValid}">
                                            <Border Width="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="0" Background="{Binding ., Converter={StaticResource DayCellConverter}, ConverterParameter=DowntimeAnalysis}" BorderBrush="#E6E6E6" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
																		<TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{Binding Index, Converter={StaticResource IndexToForegroundConverter}}" />
																	</Border>
																</Button>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</ScrollViewer>
						</StackPanel>
					</Border>
				</Grid>

				<Grid>
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
						<StackPanel>
							<TextBlock Text="Оборудование с неисправностями за выбранный день" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
							<TextBlock Text="{Binding DowntimeAnalysisDate, StringFormat='Дата: {0:dd.MM.yyyy}'}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,8" />

							<Grid ColumnDefinitions="2.2*,2.8*" Margin="4,2,4,6">
								<TextBlock Grid.Column="0" Text="Оборудование" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
								<TextBlock Grid.Column="1" Text="График" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
							</Grid>
							<Border Height="1" Background="#E6EAF0" Margin="0,0,0,4" />

                          <ItemsControl ItemsSource="{Binding DowntimeDayEquipmentRows}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="2.2*,2.8*" Margin="4,4">
											   <Button Grid.Column="0" Margin="0,0,8,0" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Click="DowntimeEquipmentButton_Click">
												<StackPanel Spacing="2">
													<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#1F2937" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
													<TextBlock Text="{Binding InventoryNumber, StringFormat='Инв: {0}'}" FontSize="11" Foreground="#6B7280" />
													<TextBlock Text="{Binding IssuesCount, StringFormat='Неисправностей: {0}'}" FontSize="11" Foreground="#6B7280" />
												</StackPanel>
											</Button>
											<Border Grid.Column="1" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="6" Background="#FFFFFF">
												   <views:TimelineControl Items="{Binding TimelinePoints}" RepairsItems="{Binding RepairsTimelinePoints}" SetupsItems="{Binding SetupsTimelinePoints}" Annotations="{Binding Annotations}" Height="56" ShowHourLabels="False" />
											</Border>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</Grid>
			</StackPanel>
		</ScrollViewer>

       <Grid Grid.Column="1" Margin="8,0,0,0" MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
			<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
				<Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
					<TextBlock Grid.Row="0" Text="Статистика" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
					<TextBlock Grid.Row="0" Text="Сводка по выбранному дню простоев" FontSize="12" Foreground="#6B7280" Margin="0,22,0,0" />

					<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
						<Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="12" HorizontalAlignment="Stretch" MinWidth="120">
							<StackPanel>
								<TextBlock Text="Дата" FontSize="12" Foreground="#7A4BAE" />
								<TextBlock Text="{Binding DowntimeAnalysisDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontWeight="Bold" />
							</StackPanel>
						</Border>
                      <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="12" Width="120" Margin="8,0,0,0">
							<StackPanel>
								<TextBlock Text="Охват" FontSize="12" Foreground="#1976D2" />
								<TextBlock Text="{Binding DowntimeAffectedSharePercent, StringFormat='{}{0:0.0}%'}" FontWeight="Bold" />
							</StackPanel>
						</Border>
					</Grid>

					<Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel Spacing="8">
							<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
								<Border Grid.Row="0" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
									<StackPanel>
										<TextBlock Text="Оборудование" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DowntimeAffectedEquipmentCount, StringFormat='{}{0} ед.'}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Border>
								<Border Grid.Row="0" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
									<StackPanel>
										<TextBlock Text="События" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DowntimeTotalIssues, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Border>
								<Border Grid.Row="1" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
									<StackPanel>
										<TextBlock Text="Ремонты" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DowntimeRepairsCount, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Border>
								<Border Grid.Row="1" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
									<StackPanel>
										<TextBlock Text="Настройки" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DowntimeSetupsCount, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Border>
								<Border Grid.Row="2" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
									<StackPanel>
										<TextBlock Text="Суммарный простой" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DowntimeTotalDuration}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Border>
								<Border Grid.Row="2" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
									<StackPanel>
										<TextBlock Text="Ср. событий / ед." FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding DowntimeAvgIssuesPerEquipment}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Border>
							</Grid>
						</StackPanel>
					</Border>

					<Border Grid.Row="3" Background="#FFFFFF" CornerRadius="0" Padding="10" BorderBrush="#E6EAF0" BorderThickness="1" VerticalAlignment="Stretch">
						<StackPanel Spacing="8">
							<TextBlock Text="Ключевые показатели дня" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
								<StackPanel>
									<TextBlock Text="Пиковый час по количеству оборудования" FontSize="11" Foreground="#6B7280" />
									<TextBlock Text="{Binding DowntimePeakHour}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" />
								</StackPanel>
							</Border>
							<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
								<StackPanel>
									<TextBlock Text="Оборудование с максимальным числом событий" FontSize="11" Foreground="#6B7280" />
                                  <TextBlock Text="{Binding DowntimeTopEquipment}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" TextWrapping="WrapWithOverflow" HorizontalAlignment="Stretch" />
									<TextBlock Text="{Binding DowntimeTopEquipmentIssues, StringFormat='{}{0} событий'}" FontSize="12" Foreground="#6B7280" />
								</StackPanel>
							</Border>
						</StackPanel>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</Grid>
 <Grid x:Name="SettingsPage" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="8,0,0,0" IsVisible="False">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="7*" />
			<ColumnDefinition Width="1.9*" />
		</Grid.ColumnDefinitions>

		<ScrollViewer Grid.Column="0" Margin="0,12,8,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
			<StackPanel Spacing="10">
			  <Grid MaxWidth="700" HorizontalAlignment="Left">
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
				   <Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel Spacing="8">
                           <TextBlock Text="Настройки импорта Jira API" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<TextBlock Text="Укажите параметры подключения к Jira REST API и нажмите «Импорт из Jira»." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />

							<StackPanel Spacing="4">
                              <TextBlock Text="URL Jira API (search)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
							  <TextBox x:Name="JiraResourceUrlBox" Watermark="https://your-jira/rest/api/2/search" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" TextChanged="JiraSettingsField_TextChanged" />
							</StackPanel>

							<StackPanel Spacing="4">
								<TextBlock Text="JQL (опционально)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
								<TextBox x:Name="JiraJqlBox" Watermark="statusCategory = Done ORDER BY resolved DESC" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" TextChanged="JiraSettingsField_TextChanged" />
							</StackPanel>

							<StackPanel Spacing="6">
                                <TextBlock Text="ID фильтров Jira для парсинга" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                   <TextBox x:Name="JiraFilterIdBox" Grid.Column="0" Watermark="10422" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" />
									<Button Grid.Column="1" Content="Добавить" Padding="10,6" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" BorderThickness="1" Click="JiraFilterIdAddButton_Click" />
								</Grid>
                                <ListBox x:Name="JiraFilterIdsList" MinHeight="90" MaxHeight="170" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" />
								<Button Content="Удалить выбранный" HorizontalAlignment="Left" Padding="10,6" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" BorderThickness="1" Click="JiraFilterIdRemoveButton_Click" />
							</StackPanel>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
								<StackPanel Grid.Column="0" Spacing="4">
									<TextBlock Text="Логин Jira (опционально)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
									<TextBox x:Name="JiraUsernameBox" Watermark="user@company.com" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" TextChanged="JiraSettingsField_TextChanged" />
								</StackPanel>
								<StackPanel Grid.Column="1" Spacing="4">
									<TextBlock Text="API Token / пароль (опционально)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
									<TextBox x:Name="JiraTokenBox" PasswordChar="*" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" />
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>
				</Grid>

				<Grid MaxWidth="700" HorizontalAlignment="Left">
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel Spacing="8">
							<TextBlock Text="Настройки карты тепла" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<TextBlock Text="Цвет ячеек изменяется от зелёного до красного в пределах заданного диапазона." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                           <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
								<TextBlock Grid.Column="0" Text="Карта:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<ComboBox Grid.Column="1"
									ItemsSource="{Binding HeatmapSettingOptions}"
									SelectedItem="{Binding SelectedHeatmapSetting, Mode=TwoWay}"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
							</Grid>
							<Grid ColumnDefinitions="Auto,130,Auto,130" ColumnSpacing="8" VerticalAlignment="Center">
								<TextBlock Grid.Column="0" Text="Минимум:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<NumericUpDown Grid.Column="1" Minimum="0" Maximum="1000" Increment="1" FormatString="F0" Value="{Binding HeatmapColorMin, Mode=TwoWay}" />
								<TextBlock Grid.Column="2" Text="Максимум:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<NumericUpDown Grid.Column="3" Minimum="1" Maximum="1000" Increment="1" FormatString="F0" Value="{Binding HeatmapColorMax, Mode=TwoWay}" />
							</Grid>
						</StackPanel>
					</Border>
				</Grid>
			</StackPanel>
		</ScrollViewer>

	   <Grid Grid.Column="1" Margin="8,0,0,0" MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
			<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
				<StackPanel Spacing="10">
					<TextBlock Text="Действия" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Импортирует данные из Jira REST API и обновляет данные оборудования в приложении." FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" />
                    <Button Content="Импорт из XML" MinWidth="140" Padding="12,8" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" BorderThickness="1" Click="ImportButton_Click" />
					<Button Content="Импорт из Jira" MinWidth="140" Padding="12,8" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" BorderThickness="1" Click="ImportFromJiraButton_Click" />
				</StackPanel>
			</Border>
		</Grid>
	</Grid>

 <Grid x:Name="EmployeeAnalysisPage" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="8,0,0,0" IsVisible="False">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="7*" />
			<ColumnDefinition Width="1.9*" />
		</Grid.ColumnDefinitions>

		<ScrollViewer Grid.Column="0" Margin="0,12,8,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
			<StackPanel Spacing="10">
               <Grid>
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
						<StackPanel Spacing="8">
							<TextBlock Text="События сотрудника за день" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<TextBlock Text="Выберите сотрудника и дату, чтобы увидеть timeline его событий" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" />

							<Grid ColumnDefinitions="Auto,*,Auto,34,130,34" ColumnSpacing="8" VerticalAlignment="Center">
								<TextBlock Grid.Column="0" Text="Сотрудник:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<ComboBox Grid.Column="1"
									ItemsSource="{Binding EmployeeTimelineEmployees}"
									SelectedItem="{Binding SelectedEmployeeTimelineEmployee, Mode=TwoWay}"
									HorizontalAlignment="Stretch"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
								<TextBlock Grid.Column="2" Text="Дата:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" />
								<Button Grid.Column="3" Classes="dateShift" Content="◀" Click="EmployeeTimelinePrevDate_Click" />
                              <CalendarDatePicker Grid.Column="4" Width="130" MinWidth="130" MaxWidth="160" HorizontalAlignment="Stretch" SelectedDate="{Binding EmployeeTimelineDate, Mode=TwoWay}" />
								<Button Grid.Column="5" Classes="dateShift" Content="▶" Click="EmployeeTimelineNextDate_Click" />
							</Grid>

							<Border Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="8">
								<views:TimelineControl Items="{Binding EmployeeTimelinePoints}" RepairsItems="{Binding EmployeeRepairsTimelinePoints}" SetupsItems="{Binding EmployeeSetupsTimelinePoints}" Annotations="{Binding EmployeeTimelineAnnotations}" Height="220" ShowHourLabels="True" ShowAnnotations="False" EnableTooltips="True" VerticalAlignment="Top" />
							</Border>
						</StackPanel>
					</Border>
				</Grid>

				<Grid>
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
						<StackPanel>
							<TextBlock Text="Анализ работы сотрудников" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<TextBlock Text="Сводная оценка нагрузки, длительности работ и распределения задач по ответственным" FontSize="12" Foreground="#6B7280" Margin="0,2,0,10" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="Auto,*,Auto,220,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,10">
								<TextBlock Grid.Column="0" Text="Период:" VerticalAlignment="Center" FontSize="12" Foreground="#374151" />
								<ComboBox Grid.Column="1"
									ItemsSource="{Binding EmployeeAnalysisMonthOptions}"
									SelectedItem="{Binding SelectedEmployeeAnalysisMonth, Mode=TwoWay}"
									HorizontalAlignment="Stretch"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
                                <TextBlock Grid.Column="2" Text="Группа:" VerticalAlignment="Center" FontSize="12" Foreground="#374151" />
								<ComboBox Grid.Column="3"
									ItemsSource="{Binding EmployeeSubdivisionFilters}"
									SelectedItem="{Binding SelectedEmployeeSubdivisionFilter, Mode=TwoWay}"
									HorizontalAlignment="Stretch"
									Background="#FFFFFF"
									BorderBrush="#D1D5DB"
									BorderThickness="1" />
								<TextBlock Grid.Column="4" Text="SLA, мин:" VerticalAlignment="Center" FontSize="12" Foreground="#374151" />
								<NumericUpDown Grid.Column="5"
									Width="130"
									Minimum="30"
									Maximum="1440"
									Increment="5"
									FormatString="F0"
									Value="{Binding SlaTargetMinutes, Mode=TwoWay}" />
							</Grid>
							<TextBlock Text="{Binding EmployeeAnalysisPeriodDescription, StringFormat='Период анализа: {0}'}" FontSize="11" Foreground="#6B7280" Margin="0,0,0,8" />

							<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
								<Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
									<StackPanel>
										<TextBlock Text="Сотрудники" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding EmployeeTotalCount, StringFormat='{}{0} чел.'}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Border>
								<Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
									<StackPanel>
										<TextBlock Text="События" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding EmployeeTotalIssues, StringFormat='{}{0} шт.'}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Border>
								<Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
									<StackPanel>
										<TextBlock Text="Ср. длительность" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding EmployeeAvgDuration}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Border>
								<Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
									<StackPanel>
										<TextBlock Text="Без ответственного" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding EmployeeUnassignedIssues, StringFormat='{}{0} шт.'}" FontSize="18" FontWeight="SemiBold" Foreground="#B45309" />
									</StackPanel>
								</Border>
							</Grid>

							<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10" Margin="0,8,0,0">
								<StackPanel Spacing="6">
									<TextBlock Text="Структура событий" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
									<Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="8">
										<TextBlock Grid.Column="0" Text="Ремонты" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" />
										<ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding EmployeeTotalIssues}" Value="{Binding EmployeeRepairsTotal}" Height="8" VerticalAlignment="Center" />
										<TextBlock Grid.Column="2" Text="{Binding EmployeeRepairsTotal, StringFormat='{}{0}'}" FontSize="11" Foreground="#111827" VerticalAlignment="Center" />
									</Grid>
									<Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="8">
										<TextBlock Grid.Column="0" Text="Настройки" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" />
										<ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding EmployeeTotalIssues}" Value="{Binding EmployeeSetupsTotal}" Height="8" VerticalAlignment="Center" />
										<TextBlock Grid.Column="2" Text="{Binding EmployeeSetupsTotal, StringFormat='{}{0}'}" FontSize="11" Foreground="#111827" VerticalAlignment="Center" />
									</Grid>
								</StackPanel>
							</Border>
						</StackPanel>
					</Border>
				</Grid>

				<Grid>
					<Border Background="Transparent" CornerRadius="0" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
						<StackPanel>
							<TextBlock Text="Детализация по сотрудникам" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                           <Grid ColumnDefinitions="2.8*,2.3*,0.7*,0.7*,0.85*,0.75*,0.75*,0.75*,0.85*,0.85*,0.75*,0.95*" Margin="4,2,4,6">
								<TextBlock Grid.Column="0" Text="Сотрудник" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
                               <TextBlock Grid.Column="1" Text="Группа" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
								<TextBlock Grid.Column="2" Text="Доля" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="3" Text="SLA" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="4" Text="Итог" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="5" Text="События" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="6" Text="Ремонт" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="7" Text="Настройка" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="8" Text="Ср. время" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="9" Text="Сумма" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="10" Text="Ед. обор." FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="11" Text="Последнее" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
							</Grid>
							<Border Height="1" Background="#E6EAF0" Margin="0,0,0,4" />
                          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" MaxHeight="560">
								<ItemsControl ItemsSource="{Binding EmployeeAnalysisRows}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
                                       <Grid ColumnDefinitions="2.8*,2.3*,0.7*,0.7*,0.85*,0.75*,0.75*,0.75*,0.85*,0.85*,0.75*,0.95*" Margin="4,3">
												<TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="#1F2937" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                          <TextBlock Grid.Column="1" Text="{Binding Subdivision}" FontSize="12" Foreground="#4B5563" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="6,0,8,0" />
											<TextBlock Grid.Column="2" Text="{Binding EventSharePercent, StringFormat='{}{0:0.#}%'}" FontSize="12" Foreground="#2563EB" HorizontalAlignment="Right" />
											<TextBlock Grid.Column="3" Text="{Binding SlaCompliancePercent, StringFormat='{}{0:0.#}%'}" FontSize="12" Foreground="#0F766E" HorizontalAlignment="Right" />
											<TextBlock Grid.Column="4" Text="{Binding PerformanceSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#111827" HorizontalAlignment="Right" />
											<TextBlock Grid.Column="5" Text="{Binding IssuesCount}" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" />
											<TextBlock Grid.Column="6" Text="{Binding RepairsCount}" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" />
											<TextBlock Grid.Column="7" Text="{Binding SetupsCount}" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" />
											<TextBlock Grid.Column="8" Text="{Binding AvgDurationText}" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" />
											<TextBlock Grid.Column="9" Text="{Binding TotalDurationText}" FontSize="12" FontWeight="SemiBold" Foreground="#111827" HorizontalAlignment="Right" />
											<TextBlock Grid.Column="10" Text="{Binding EquipmentCount}" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" />
											<TextBlock Grid.Column="11" Text="{Binding LastIssueDateText}" FontSize="12" Foreground="#4B5563" HorizontalAlignment="Right" />
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</StackPanel>
					</Border>
				</Grid>
			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Column="1" Margin="8,0,0,0" MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
			<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="14">
				<StackPanel Spacing="10">
					<TextBlock Text="Сводка по эффективности" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
					<TextBlock Text="Показывает лидеров по активности и суммарной занятости. Данные строятся по всем импортированным событиям." FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" />

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel>
							<TextBlock Text="Покрытие ответственными" FontSize="11" Foreground="#6B7280" />
							<TextBlock Text="{Binding EmployeeCoveragePercent, StringFormat='{}{0:0.0}%'}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                           <ProgressBar Minimum="0" Maximum="100" Value="{Binding EmployeeCoveragePercent}" Height="7" Margin="0,6,0,0" />
						</StackPanel>
					</Border>

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel>
							<TextBlock Text="Средний охват оборудования" FontSize="11" Foreground="#6B7280" />
							<TextBlock Text="{Binding EmployeeAvgEquipmentPerEmployee, StringFormat='{}{0} ед./сотр.'}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                          <TextBlock Text="{Binding EmployeeUnassignedIssues, StringFormat='Нераспределено: {0}'}" FontSize="12" Foreground="#B45309" />
						</StackPanel>
					</Border>

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel>
							<TextBlock Text="SLA по событиям" FontSize="11" Foreground="#6B7280" />
							<TextBlock Text="{Binding EmployeeSlaCompliancePercent, StringFormat='Соблюдение: {0:0.0}%'}" FontSize="14" FontWeight="SemiBold" Foreground="#0F766E" />
							<TextBlock Text="{Binding EmployeeSlaBreaches, StringFormat='Нарушено: {0}'}" FontSize="12" Foreground="#B91C1C" />
						</StackPanel>
					</Border>

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel>
							<TextBlock Text="Лидер по числу событий" FontSize="11" Foreground="#6B7280" />
							<TextBlock Text="{Binding EmployeeTopByIssues}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" />
							<TextBlock Text="{Binding EmployeeTopByIssuesValue}" FontSize="12" Foreground="#6B7280" />
						</StackPanel>
					</Border>

					<Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="0" Padding="10">
						<StackPanel>
							<TextBlock Text="Максимальная занятость" FontSize="11" Foreground="#6B7280" />
							<TextBlock Text="{Binding EmployeeTopByDuration}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" />
							<TextBlock Text="{Binding EmployeeTopByDurationValue, StringFormat='Суммарно: {0}'}" FontSize="12" Foreground="#6B7280" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
	</Grid>
</Window>

