<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:EquipmentFailureAnalysis.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:effects="clr-namespace:Avalonia.Media.Effects;assembly=Avalonia.Visuals"
		xmlns:utility="using:EquipmentFailureAnalysis.Utility"
		xmlns:views="using:EquipmentFailureAnalysis.Views"
		mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
     x:Class="EquipmentFailureAnalysis.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
		Title="DEA - Equipment Failure Analysis"
		Background="{StaticResource PrimaryBackground}"
		WindowState="Maximized">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainWindowViewModel/>
	</Design.DataContext>

    <Window.Resources>
     <utility:ValueToColorConverter x:Key="ColorConverter"/>
        <utility:DayCellToBrushConverter x:Key="DayCellConverter" />
        <utility:RepairsToBrushConverter x:Key="RepairsToBrushConverter" />
        <utility:RepairsToStatusConverter x:Key="RepairsToStatusConverter" />
        <utility:RepairsToForegroundConverter x:Key="RepairsToForegroundConverter" />
		<utility:BinaryToBrushConverter x:Key="BinaryConverter"/>
		<utility:StatusToBrushConverter x:Key="StatusToBrush" />
		<utility:SelectedToBackgroundConverter x:Key="SelectedToBackground" />
		<utility:IndexToForegroundConverter x:Key="IndexToForegroundConverter" />

        <!-- Typography / card styles using class selectors -->
		<FontFamily x:Key="AppFont">Segoe UI</FontFamily>
        <Style x:Key="HeaderTitleStyle" Selector="TextBlock.headerTitle">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="30" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="#FFFFFF" />
			<Setter Property="Margin" Value="0,0,0,0" />
		</Style>
        <Style x:Key="SectionTitleStyle" Selector="TextBlock.sectionTitle">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>
        <Style x:Key="CardTitleStyle" Selector="TextBlock.cardTitle">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>
        <Style x:Key="CardValueStyle" Selector="TextBlock.cardValue">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="20" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>
        <Style x:Key="CardSubtextStyle" Selector="TextBlock.cardSubtext">
			<Setter Property="FontFamily" Value="{StaticResource AppFont}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="#666" />
		</Style>

		<!-- Button tweaks -->
        <Style x:Key="IconButtonStyle" Selector="Button.smallIcon">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="28" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<!-- Legend brushes for heatmap (brighter stops) -->
		<SolidColorBrush x:Key="HeatmapGreen" Color="#81C784" />
		<SolidColorBrush x:Key="HeatmapYellow" Color="#FFEE58" />
		<SolidColorBrush x:Key="HeatmapOrange" Color="#FFB74D" />
		<SolidColorBrush x:Key="HeatmapRed" Color="#EF5350" />

		<!-- Palette -->
       <SolidColorBrush x:Key="PrimaryBackground" Color="#EEF2F6" />
        <!-- Header gradient -->
      <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#26486F" Offset="0" />
			<GradientStop Color="#1E3A5F" Offset="1" />
		</LinearGradientBrush>
        <SolidColorBrush x:Key="CardBackground" Color="#FCFDFE" />
		<SolidColorBrush x:Key="AccentBrush" Color="#1976D2" />
		<SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
     <SolidColorBrush x:Key="TextPrimary" Color="#1F2937" />

		<!-- Styles -->
        <Style x:Key="SidebarButtonStyle" Selector="Button">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="#E0E0E0" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>

        <Style x:Key="DayButtonStyle" Selector="Button.Day">
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="BorderBrush" Value="#CFCFCF" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
		</Style>

    </Window.Resources>

	<Window.Styles>
		<!-- Implicit style to completely hide ScrollBar visuals while keeping scrolling behavior -->
		<Style Selector="ScrollBar">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="Transparent" Width="0" Height="0" />
				</ControlTemplate>
			</Setter>
		</Style>
	</Window.Styles>

	<Grid>
        <Grid.ColumnDefinitions>
			<!-- Use star sizing so layout adapts when window is resized -->
			<ColumnDefinition Width="2*" />
			<ColumnDefinition Width="6*" />
			<ColumnDefinition Width="2*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

 <!-- Top header -->
	<Border Grid.ColumnSpan="3" Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="12" CornerRadius="10" Margin="10,10,10,8">
		<Grid VerticalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
				<Image Source="/Assets/avalonia-logo.ico" Width="44" Height="44" />
				<StackPanel Orientation="Vertical" VerticalAlignment="Center">
					<TextBlock Classes="headerTitle" Text="Анализ неисправностей оборудования" Foreground="#E8F3FF" />
					<TextBlock FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="#E8F3FF">Мониторинг рабочих смен и простоев</TextBlock>
				</StackPanel>
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
				<Button Content="Импорт" MinWidth="84" Background="#FFFFFF" Foreground="Black" Click="ImportButton_Click" />
			</StackPanel>
		</Grid>
	</Border>

    <Grid Grid.Column="0" Grid.Row="1" Margin="8" MinWidth="220" MaxWidth="360">
			<!-- shadow shim -->
         <Border Background="#12000000" CornerRadius="8" Margin="0,6,0,0" />
				<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="8" Padding="14">
          <StackPanel Spacing="10">
				<TextBlock Text="Навигация" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="6,2" />
				<Button Content="Дашборд" HorizontalAlignment="Stretch" />
				<Button Content="Карта тепла" HorizontalAlignment="Stretch" />
				<Button Content="График простоев" HorizontalAlignment="Stretch" />
				<Button Content="Статистика" HorizontalAlignment="Stretch" />
			</StackPanel>
			</Border>
		</Grid>
        <!-- central column: only vertical scrolling; heatmap has its own horizontal scroller -->
        <ScrollViewer Grid.Column="1" Grid.Row="1" Margin="8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
			<StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch">
              <Grid Margin="0,0,0,8">
					<Border Background="#12000000" CornerRadius="8" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="8" Padding="14">
						<StackPanel>
                          <TextBlock Text="Поиск и фильтрация" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
							<TextBlock Text="Выберите оборудование через строку поиска и задайте режим отображения данных" FontSize="12" Foreground="#6B7280" Margin="0,2,0,8" />
							<Grid VerticalAlignment="Center" Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
                                   <ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
                               <Border Grid.Column="0" Background="#FFFFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="8" Padding="4" VerticalAlignment="Center" Margin="0,0,8,0">
									<ComboBox Name="EquipmentSearchBox"
										ItemsSource="{Binding EquipmentCollection}"
										SelectedItem="{Binding SelectedEquipmentFromSearch, Mode=TwoWay}"
										Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										IsEditable="True"
										HorizontalAlignment="Stretch"
										BorderThickness="0"
										Background="Transparent"
                                        PlaceholderText="Поиск оборудования..."
										MaxDropDownHeight="320">
										<ComboBox.ItemTemplate>
											<DataTemplate>
                                               <Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="2">
													<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
														<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="#111827" />
														<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
															<TextBlock Text="{Binding InventoryNumber, StringFormat='Инв: {0}'}" Foreground="#6B7280" FontSize="11" />
															<TextBlock Text="{Binding IssueCount, StringFormat='Неисправностей: {0}'}" Foreground="#6B7280" FontSize="11" />
														</StackPanel>
														<Ellipse Grid.RowSpan="2" Grid.Column="1" Width="10" Height="10" Fill="{Binding HasIssues, Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center" Margin="8,0,0,0" />
													</Grid>
												</Border>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
								</Border>
                              <Button Grid.Column="1" MinWidth="110" Background="#FFFFFF" Foreground="#111827" BorderBrush="#D1D5DB" BorderThickness="1" Click="FilterButton_Click">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="Фильтр:" FontSize="12" Foreground="#6B7280" />
										<TextBlock Text="{Binding SelectedIssueTypeFilter}" FontSize="12" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
								</Button>
							</Grid>
                           <Border Background="#F8FAFC" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="8" Padding="8,6">
								<Grid ColumnDefinitions="*,Auto">
									<StackPanel>
										<TextBlock Text="Найдено оборудования" FontSize="11" Foreground="#6B7280" />
										<TextBlock Text="{Binding EquipmentCollection.Count, StringFormat='{}{0} поз.'}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
									</StackPanel>
									<TextBlock Grid.Column="1" Text="Нажмите на поиск для выбора" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="12,0,0,0" />
								</Grid>
							</Border>
						</StackPanel>
					</Border>
				</Grid>
                <!-- Top header showing day numbers moved into heatmap block for alignment -->

                <Grid Margin="0 0 0 8">
                 <Border Background="#12000000" CornerRadius="8" Margin="0,6,0,0" />
						<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="8" Padding="14">
					<StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Classes="sectionTitle" Text="Карта тепла" Margin="0,0,0,8" />
						<Grid>
							<!-- single scroll area that contains both day headers and month rows so they scroll together -->
                            <ScrollViewer x:Name="HeatmapScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
								<StackPanel Margin="2">
                                    <!-- Day headers aligned with day cells (use width matching day cell width + margin) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                        <TextBlock Width="72" />
										<ItemsControl ItemsSource="{Binding DayHeaders}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
                                                <DataTemplate>
													<Border Width="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="2" Background="Transparent">
														<TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#666" />
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>

                                    <!-- Month rows -->
									<ItemsControl ItemsSource="{Binding MonthRows}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Vertical" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
													<TextBlock Text="{Binding MonthName}" Width="72" VerticalAlignment="Center" Margin="2" />
													<ItemsControl ItemsSource="{Binding Days}">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<StackPanel Orientation="Horizontal" />
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Margin="2" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"
																		Command="{Binding DataContext.ShowDayTimelineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
																		CommandParameter="{Binding Date}" IsVisible="{Binding IsValid}">
                                                                    <Border Width="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="4" Background="{Binding ., Converter={StaticResource DayCellConverter}}" BorderBrush="#E6E6E6" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
																		<TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{Binding Index, Converter={StaticResource IndexToForegroundConverter}}" />
																	</Border>
                                                                <ToolTip.Tip>
																	<StackPanel>
																		<TextBlock Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}" />
																		<TextBlock Text="{Binding Index, StringFormat='Неисправностей: {0}'}" />
																	</StackPanel>
																</ToolTip.Tip>
																<Button.ContextMenu>
																	<ContextMenu>
																		<MenuItem Header="Показать в дашборде" Command="{Binding DataContext.LoadEquipmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.SelectedEquipment, RelativeSource={RelativeSource AncestorType=Window}}" />
																	</ContextMenu>
																</Button.ContextMenu>
																</Button>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
                                    </ItemsControl>
								</StackPanel>

							</ScrollViewer>
						</Grid>

						<!-- Heatmap legend -->
						<StackPanel Orientation="Horizontal" Margin="8,6,0,0" HorizontalAlignment="Left">
							<TextBlock Text="Легенда:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,8,0" />
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Border Width="24" Height="14" Background="{StaticResource HeatmapGreen}" CornerRadius="3" BorderBrush="#DDD" BorderThickness="1" />
								<TextBlock Text=" 0" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Border Width="24" Height="14" Background="{StaticResource HeatmapYellow}" CornerRadius="3" BorderBrush="#DDD" BorderThickness="1" />
								<TextBlock Text=" 3-6" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Border Width="24" Height="14" Background="{StaticResource HeatmapOrange}" CornerRadius="3" BorderBrush="#DDD" BorderThickness="1" />
								<TextBlock Text=" 7-9" VerticalAlignment="Center" Foreground="#444" Margin="6,0,10,0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Border Width="24" Height="14" Background="{StaticResource HeatmapRed}" CornerRadius="3" BorderBrush="#DDD" BorderThickness="1" />
								<TextBlock Text=" 10+" VerticalAlignment="Center" Foreground="#444" Margin="6,0,0,0" />
							</StackPanel>
						</StackPanel>
                    </StackPanel>
					</Border>
				</Grid>

				<!-- Timeline panel showing 24-hour state blocks under heatmap -->
                <Grid>
                 <Border Background="#12000000" CornerRadius="8" Margin="0,6,0,0" />
					<Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="8" Padding="14">
					<StackPanel>
                        <TextBlock Classes="sectionTitle" Text="График простоев" Margin="0,0,0,8" />
                        <Grid>
							<views:TimelineControl Items="{Binding DayTimelinePoints}" RepairsItems="{Binding RepairsTimelinePoints}" SetupsItems="{Binding SetupsTimelinePoints}" Annotations="{Binding Annotations}" Height="480" ShowHourLabels="True" VerticalAlignment="Top" />
							<Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Background="#CCFFFFFF" BorderBrush="#D6DEE8" BorderThickness="1" CornerRadius="8" Padding="8,6">
								<StackPanel Spacing="4">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Border Width="14" Height="3" Background="#D32F2F" VerticalAlignment="Center" />
										<TextBlock Text="Ремонт" FontSize="12" Foreground="#1F2937" VerticalAlignment="Center" />
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Border Width="14" Height="3" Background="#FBC02D" VerticalAlignment="Center" />
										<TextBlock Text="Настройка" FontSize="12" Foreground="#1F2937" VerticalAlignment="Center" />
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Border Width="14" Height="3" Background="#FF8F00" VerticalAlignment="Center" />
										<TextBlock Text="Пересечение" FontSize="12" Foreground="#1F2937" VerticalAlignment="Center" />
									</StackPanel>
								</StackPanel>
							</Border>
						</Grid>
					</StackPanel>
				</Border>
				</Grid>
		</StackPanel>
		</ScrollViewer>
   <Grid Grid.Column="2" Grid.Row="1" Margin="8" MinWidth="220" MaxWidth="360">
     <Border Background="#12000000" CornerRadius="8" Margin="0,6,0,0" />
               <Border Background="{StaticResource CardBackground}" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="8" Padding="14">
					<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">

						<TextBlock Grid.Row="0" Text="Статистика" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />

						<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
							<Border Grid.Column="0" Background="#EAF2FF" CornerRadius="8" Padding="12" HorizontalAlignment="Stretch" MinWidth="120">
								<StackPanel>
									<TextBlock Text="Оборудование" FontSize="12" Foreground="#1976D2" />
									<TextBlock Text="{Binding SelectedEquipment.Title}" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
									<TextBlock Text="{Binding SelectedEquipment.InventoryNumber}" FontSize="12" Foreground="#666" />
								</StackPanel>
							</Border>
							<Border Grid.Column="1" Background="#F6EAFB" CornerRadius="8" Padding="12" Width="120" Margin="8,0,0,0">
								<StackPanel>
									<TextBlock Text="Дата" FontSize="12" Foreground="#7A4BAE" />
									<TextBlock Text="{Binding AnalysisDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontWeight="Bold" />
								</StackPanel>
							</Border>
						</Grid>

						<Border Grid.Row="2" Background="{Binding SelectedDayRepairs, Converter={StaticResource RepairsToBrushConverter}}" CornerRadius="8" Padding="12">
							<StackPanel>
								<TextBlock Classes="cardTitle" Text="Статус ремонтов" Foreground="{Binding SelectedDayRepairs, Converter={StaticResource RepairsToForegroundConverter}}" />
								<TextBlock Classes="cardValue" Text="{Binding SelectedDayRepairs, StringFormat='{}{0} шт.'}" Foreground="#000000" FontSize="20" FontWeight="Bold" Margin="0,6,0,0" />
								<TextBlock Classes="cardSubtext" Text="{Binding SelectedDayRepairs, Converter={StaticResource RepairsToStatusConverter}}" Foreground="{Binding SelectedDayRepairs, Converter={StaticResource RepairsToForegroundConverter}}" Margin="0,8,0,0" HorizontalAlignment="Left" />
							</StackPanel>
						</Border>

						<Border Grid.Row="3" Background="#FFFFFF" CornerRadius="8" Padding="12">
							<StackPanel>
								<TextBlock Text="Время работы / простои" FontSize="13" Foreground="#666" />
								<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
									<StackPanel Width="80">
										<TextBlock Text="Работа" Foreground="#2E7D32" />
										<TextBlock Text="{Binding WorkPercent, StringFormat='{}{0:0.0}%'}" Foreground="#2E7D32" FontWeight="Bold" />
									</StackPanel>
									<StackPanel Width="80">
										<TextBlock Text="Простой" Foreground="#B00020" />
										<TextBlock Text="{Binding DownPercent}" Foreground="#B00020" FontWeight="Bold" />
									</StackPanel>
								</StackPanel>
								<ProgressBar Value="{Binding WorkPercent}" Maximum="100" Minimum="0" Height="8" Margin="0,8,0,0" />
							</StackPanel>
						</Border>

						<Border Grid.Row="4" Background="#FFF8E1" CornerRadius="8" Padding="12">
							<StackPanel>
								<TextBlock Text="Среднее время ремонта" FontSize="13" Foreground="#BF7000" />
								<TextBlock Text="{Binding AvgRepairTime}" FontSize="20" FontWeight="Bold" Margin="0,6,0,0" />
							</StackPanel>
						</Border>

						<Border Grid.Row="5" Background="#FFFFFF" CornerRadius="8" Padding="8" BorderBrush="#E6EAF0" BorderThickness="1" VerticalAlignment="Stretch">
							<Grid RowDefinitions="Auto,Auto,*">
								<TextBlock Grid.Row="0" Text="Неисправности за выбранный день" FontSize="13" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6" />
								<Grid Grid.Row="1" ColumnDefinitions="2.6*,1.2*,1*" Margin="4,2,4,6">
									<TextBlock Grid.Column="0" Text="Неисправность" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
									<TextBlock Grid.Column="1" Text="Ответственный" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
									<TextBlock Grid.Column="2" Text="Время" FontWeight="SemiBold" FontSize="12" Foreground="#374151" HorizontalAlignment="Right" />
								</Grid>
								<Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="#E6EAF0" Margin="0,0,0,2" />
								<ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
									<ItemsControl ItemsSource="{Binding Annotations}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Grid ColumnDefinitions="2.6*,1.2*,1*" Margin="4,3">
													<TextBlock Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="12" Foreground="#1F2937" />
													<TextBlock Grid.Column="1" Text="{Binding Responsible}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="12" Foreground="#4B5563" Margin="8,0,6,0" />
													<TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="#111827" />
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Grid>
						</Border>
					</Grid>
				</Border>
	</Grid>
	</Grid>
</Window>
