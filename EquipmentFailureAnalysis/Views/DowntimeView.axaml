<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EquipmentFailureAnalysis.Views"
             x:Class="EquipmentFailureAnalysis.Views.DowntimeView">

    <Grid x:Name="DowntimeLayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="600" />
            <ColumnDefinition Width="*" MinWidth="320" MaxWidth="480" />
        </Grid.ColumnDefinitions>

        <!-- ====================================================
             CENTER COLUMN — Filters / Heatmap / Equipment rows
             ==================================================== -->
        <ScrollViewer x:Name="DowntimeCenterColumn"
                      Grid.Column="0"
                      Margin="20,18,16,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- ============== PAGE HEADER ============== -->
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Анализ простоев" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Карта тепла и детализация инцидентов по дням"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                    <!-- Layout switcher: heatmap full / split -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentSoftBackground}"
                                BorderBrush="{DynamicResource AccentSoftBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="10,5"
                                VerticalAlignment="Center"
                                IsVisible="{Binding DowntimeMonthRows.Count}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource AccentForeground}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DowntimeYearLabel"
                                           Text="{Binding DowntimeHeatmapYearLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentForeground}"
                                            VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
 
                 <!-- ============== UNIVERSAL FILTER BAR ============== -->
                 <!-- Collapsible filter bar — expanded by default for visibility, but compact header -->
                 <Border Classes="panelFlat" Padding="0">
                     <Expander x:Name="FilterExpander" IsExpanded="False" HorizontalAlignment="Stretch">
                         <Expander.Header>
                             <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,2">
                                 <Border Grid.Column="0"
                                         Width="32" Height="32"
                                         CornerRadius="8"
                                         Background="{DynamicResource AccentSoftBackground}"
                                         VerticalAlignment="Center">
                                     <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                                                FontSize="14"
                                                Foreground="{DynamicResource AccentForeground}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                 </Border>
                                 <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center" Margin="10,0,0,0">
                                     <TextBlock Text="Универсальный фильтр" FontSize="12" FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}" />
                                     <TextBlock Text="Тип, статус, ответственный, группа, оборудование"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextMuted}" />
                                 </StackPanel>
 
                                  <Button Grid.Column="2"
                                          Classes="resetFilter"
                                          Content="Сбросить"
                                          Margin="8,0,0,0"
                                          Command="{Binding ResetUniversalFiltersCommand}"
                                          Click="ResetFiltersWithToast_Click" />
                              </Grid>
                          </Expander.Header>

                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <Border Height="1" Background="{DynamicResource RowDividerBrush}" />

                            <Grid ColumnDefinitions="Auto,*,12,Auto,*,12,Auto,*,12,Auto,*"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="8" ColumnSpacing="0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding DowntimeIssueTypeFilters}"
                                          SelectedItem="{Binding SelectedDowntimeIssueTypeFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Статус"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="4"
                                          ItemsSource="{Binding DowntimeStatusFilters}"
                                          SelectedItem="{Binding SelectedDowntimeStatusFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="0" Grid.Column="6" Text="Ответственный"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="7"
                                          ItemsSource="{Binding DowntimeResponsibleFilters}"
                                          SelectedItem="{Binding SelectedDowntimeResponsibleFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="0" Grid.Column="9" Text="Группа"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="10"
                                          ItemsSource="{Binding DowntimeSubdivisionFilters}"
                                          SelectedItem="{Binding SelectedDowntimeSubdivisionFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Оборудование"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="10"
                                         Watermark="Поиск по названию или инв. номеру"
                                         Text="{Binding DowntimeEquipmentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- ============== HEATMAP CARD ============== -->
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Карта тепла" Classes="sectionTitle" />
                                <TextBlock Text="Значение ячейки — количество единиц оборудования с неисправностями за день"
                                           Classes="sectionSubtitle" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="smallIcon"
                                    ToolTip.Tip="Настройки градации"
                                    Click="DowntimeHeatmapSettingsButton_Click">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <Border Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10" Padding="14">
                                            <StackPanel Spacing="10" MinWidth="320" MaxWidth="360">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Настройки градации карты"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="Диапазон значений для карты простоев"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Height="1" Background="{DynamicResource RowDividerBrush}" />
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                                      ColumnSpacing="10" RowSpacing="8" VerticalAlignment="Center">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Минимум"
                                                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center" />
                                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1000"
                                                                   Increment="1" FormatString="F0"
                                                                   Value="{Binding HeatmapColorMin, Mode=TwoWay}"
                                                                   HorizontalAlignment="Stretch" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Максимум"
                                                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center" />
                                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000"
                                                                   Increment="1" FormatString="F0"
                                                                   Value="{Binding HeatmapColorMax, Mode=TwoWay}"
                                                                   HorizontalAlignment="Stretch" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <Border Classes="well" Padding="0">
                            <Grid>
                                <ScrollViewer x:Name="DowntimeHeatmapScroller"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Background="Transparent">
                                    <views:HeatmapGridControl DayHeaders="{Binding DayHeaders}"
                                                             MonthRows="{Binding DowntimeMonthRows}"
                                                             CellCommand="{Binding ShowDowntimeDayCommand}"
                                                             SelectedDate="{Binding DowntimeAnalysisDate, Mode=TwoWay}"
                                                             ConverterMode="DowntimeAnalysis" />
                                </ScrollViewer>

                                <!-- Empty state for heatmap -->
                                <Border Classes="emptyState"
                                        IsVisible="{Binding DowntimeMonthRows, Converter={StaticResource IsEmptyConverter}}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="320">
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{DynamicResource AccentSoftBackground}">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource AccentForeground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Classes="emptyStateTitle" Text="Нет данных для отображения"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Classes="emptyStateSubtitle"
                                                   Text="Импортируйте данные из XML или Jira, чтобы увидеть карту простоев"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Legend (reactive to HeatmapColorMin/Max) -->
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,2,0,0">
                            <TextBlock Text="Градация:" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="22" Height="12" Background="{StaticResource HeatmapGreen}" CornerRadius="4" />
                                <TextBlock Text="{Binding HeatmapColorMin, StringFormat='до {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="22" Height="12" Background="{StaticResource HeatmapYellow}" CornerRadius="4" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}–{1}">
                                            <Binding Path="HeatmapColorMin" />
                                            <Binding Path="HeatmapColorMax" Converter="{StaticResource HeatmapMidValueConverter}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="22" Height="12" Background="{StaticResource HeatmapOrange}" CornerRadius="4" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}–{1}">
                                            <Binding Path="HeatmapColorMax" Converter="{StaticResource HeatmapMidValueConverter}" />
                                            <Binding Path="HeatmapColorMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="22" Height="12" Background="{StaticResource HeatmapRed}" CornerRadius="4" />
                                <TextBlock Text="{Binding HeatmapColorMax, StringFormat='от {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============== EQUIPMENT LIST CARD ============== -->
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Оборудование с неисправностями за выбранный день"
                                           Classes="sectionTitle" />
                                <TextBlock Text="{Binding DowntimeAnalysisDate, StringFormat='Дата: {0:dd.MM.yyyy}'}"
                                           Classes="sectionSubtitle" />
                            </StackPanel>
                        </Grid>

                        <Border Classes="well" Padding="0">
                            <Grid>
                                <StackPanel>
                                    <!-- Sticky header row -->
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="10,10,0,0"
                                            Padding="14,10">
                                        <Grid ColumnDefinitions="2.2*,2.8*">
                                            <TextBlock Grid.Column="0" Text="Оборудование"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="График работ и простоев"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                    </Border>

                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="420">
                                        <ItemsControl ItemsSource="{Binding DowntimeDayEquipmentRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="downtimeEquipmentRow"
                                                            BorderBrush="{DynamicResource RowDividerBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Margin="0" Padding="10,8">
                                                        <Grid ColumnDefinitions="2.2*,2.8*" Margin="2,1">
                                                            <Border Grid.Column="0" Margin="0,0,8,0" Background="Transparent"
                                                                    PointerPressed="DowntimeEquipmentButton_Click">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                                    <TextBlock Text="{Binding InventoryNumber, StringFormat='Инв. номер: {0}'}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource TextMuted}" />
                                                                    <TextBlock Text="{Binding IssuesCount, StringFormat='Неисправностей: {0}'}"
                                                                               FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AccentForeground}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="1"
                                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                    BorderThickness="1" CornerRadius="8" Padding="6"
                                                                    Background="{DynamicResource SurfaceBrush}">
                                                                <views:TimelineControl Items="{Binding TimelinePoints}"
                                                                                       RepairsItems="{Binding RepairsTimelinePoints}"
                                                                                       SetupsItems="{Binding SetupsTimelinePoints}"
                                                                                       Annotations="{Binding Annotations}"
                                                                                       Height="56" ShowHourLabels="False" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Empty state overlay — shown when list is empty -->
                                <Border Classes="emptyState"
                                        IsVisible="{Binding DowntimeDayEquipmentRows, Converter={StaticResource IsEmptyConverter}}"
                                        Margin="0,50,0,0">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10"
                                                Background="{DynamicResource SuccessSoftBackground}">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Classes="emptyStateTitle" Text="Неисправностей не зафиксировано"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Classes="emptyStateSubtitle"
                                                   Text="За выбранный день нет событий по оборудованию"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ====================================================
             RIGHT COLUMN — Day summary / KPIs / Peak insights
             ==================================================== -->
        <Grid x:Name="DowntimeRightColumn" Grid.Column="1"
              MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">

                        <!-- Section header -->
                        <StackPanel Spacing="2">
                            <TextBlock Classes="eyebrow" Text="ВЫБРАННЫЙ ДЕНЬ" />
                            <TextBlock Text="Сводка по простоям" Classes="sectionTitle" />
                            <TextBlock Text="Сводные показатели и инциденты за выбранный день"
                                       Classes="sectionSubtitle" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Date + Coverage pair -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Classes="well">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="6"
                                                Background="{DynamicResource AccentSoftBackground}">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentForeground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Дата" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DowntimeAnalysisDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <!-- Date preset buttons -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                        <Button Classes="soft" Padding="8,3" FontSize="10"
                                                Click="DowntimeSetToday_Click" Content="Сегодня" />
                                        <Button Classes="ghost" Padding="8,3" FontSize="10"
                                                Click="DowntimeSetYesterday_Click" Content="Вчера" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="well">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="20" Height="20" CornerRadius="6"
                                                Background="{DynamicResource WarningSoftBackground}">
                                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Охват" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DowntimeAffectedSharePercent, StringFormat='{}{0:0.0}%'}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- KPI 2x3 grid -->
                        <Border Classes="well">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Сводные показатели" Classes="cardTitle" />
                                    <TextBlock Text="Оборудование, события и длительность"
                                               Classes="cardSubtext" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="10" ColumnSpacing="10">

                                    <!-- Оборудование -->
                                    <Border Grid.Row="0" Grid.Column="0"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Оборудование" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding DowntimeAffectedEquipmentCount, StringFormat='{}{0} ед.'}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- События -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="События" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding DowntimeTotalIssues, StringFormat='{}{0} шт.'}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Ремонты -->
                                    <Border Grid.Row="1" Grid.Column="0"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Ремонты" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding DowntimeRepairsCount, StringFormat='{}{0} шт.'}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Настройки -->
                                    <Border Grid.Row="1" Grid.Column="1"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Настройки" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding DowntimeSetupsCount, StringFormat='{}{0} шт.'}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Суммарный простой -->
                                    <Border Grid.Row="2" Grid.Column="0"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Суммарный простой" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding DowntimeTotalDuration}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Ср. событий / ед. -->
                                    <Border Grid.Row="2" Grid.Column="1"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Ср. событий / ед." FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding DowntimeAvgIssuesPerEquipment}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentForeground}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Day insights: peak hour -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Время нагрузки" Classes="eyebrow" />
                            <Border Classes="well">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6"
                                                Background="{DynamicResource AccentSoftBackground}">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentForeground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Пиковый час" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="По количеству оборудования"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding DowntimePeakHour}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="—"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMuted}"
                                               IsVisible="{Binding DowntimePeakHour, Converter={StaticResource IsEmptyConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Top equipment insight -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Анализ инцидентов" Classes="eyebrow" />
                            <Border Background="{DynamicResource DangerSoftBackground}"
                                    BorderBrush="{DynamicResource DangerSoftBorder}"
                                    BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="6"
                                                Background="{DynamicResource DangerBrush}">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Максимум событий на оборудование"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DowntimeTopEquipment}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Нет инцидентов в выбранный день"
                                               FontSize="12" FontStyle="Italic"
                                               Foreground="{DynamicResource TextMuted}"
                                               IsVisible="{Binding DowntimeTopEquipment, Converter={StaticResource IsEmptyConverter}}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DowntimeTopEquipmentIssues, StringFormat='{}{0} событий'}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
