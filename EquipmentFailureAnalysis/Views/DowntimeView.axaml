<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EquipmentFailureAnalysis.Views"
             x:Class="EquipmentFailureAnalysis.Views.DowntimeView">
    <Grid x:Name="DowntimeLayoutRoot">
        		<Grid.ColumnDefinitions>
        			<ColumnDefinition Width="7*" />
        			<ColumnDefinition Width="440" />
        		</Grid.ColumnDefinitions>
        
               <ScrollViewer x:Name="DowntimeCenterColumn" Grid.Column="0" Margin="0,12,8,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                   <StackPanel Spacing="10">
                    <Grid>
        					<Border Background="Transparent" CornerRadius="8" Margin="0,6,0,0" />
        					<Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        						<StackPanel Spacing="8">
        							<TextBlock Text="Универсальный фильтр" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        							<TextBlock Text="Фильтрация по типу, статусу, ответственному и оборудованию" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                    <Grid ColumnDefinitions="Auto,140,Auto,160,Auto,190,Auto,170,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        								<TextBlock Grid.Column="0" Text="Тип:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="1"
        									ItemsSource="{Binding DowntimeIssueTypeFilters}"
        									SelectedItem="{Binding SelectedDowntimeIssueTypeFilter, Mode=TwoWay}"
        									Background="{DynamicResource SurfaceBrush}"
        									BorderBrush="{DynamicResource ControlBorderBrush}"
        									BorderThickness="1" />
        								<TextBlock Grid.Column="2" Text="Статус:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="3"
        									ItemsSource="{Binding DowntimeStatusFilters}"
        									SelectedItem="{Binding SelectedDowntimeStatusFilter, Mode=TwoWay}"
        									Background="{DynamicResource SurfaceBrush}"
        									BorderBrush="{DynamicResource ControlBorderBrush}"
        									BorderThickness="1" />
        								<TextBlock Grid.Column="4" Text="Ответственный:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="5"
        									ItemsSource="{Binding DowntimeResponsibleFilters}"
        									SelectedItem="{Binding SelectedDowntimeResponsibleFilter, Mode=TwoWay}"
        									Background="{DynamicResource SurfaceBrush}"
        									BorderBrush="{DynamicResource ControlBorderBrush}"
        									BorderThickness="1" />
                                        <TextBlock Grid.Column="6" Text="Группа:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
        								<ComboBox Grid.Column="7"
        									ItemsSource="{Binding DowntimeSubdivisionFilters}"
        									SelectedItem="{Binding SelectedDowntimeSubdivisionFilter, Mode=TwoWay}"
        									Background="{DynamicResource SurfaceBrush}"
        									BorderBrush="{DynamicResource ControlBorderBrush}"
        									BorderThickness="1" />
        								<TextBlock Grid.Column="8" Text="Оборудование:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
        								<TextBox Grid.Column="9"
        									Watermark="Поиск по названию или инв. номеру"
        									Text="{Binding DowntimeEquipmentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        									Background="{DynamicResource SurfaceBrush}"
        									BorderBrush="{DynamicResource ControlBorderBrush}"
        									BorderThickness="1" />
                                     <Button Grid.Column="10"
                                         Classes="resetFilter"
        									Content="Сброс"
        									Command="{Binding ResetUniversalFiltersCommand}" />
        							</Grid>
        						</StackPanel>
        					</Border>
        				</Grid>
        
                     <Grid>
        					<Border Background="Transparent" CornerRadius="8" Margin="0,6,0,0" />
        					<Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        						<StackPanel HorizontalAlignment="Stretch">
                                 <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
        								<TextBlock Grid.Column="0" Text="Карта тепла" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        							<Button Grid.Column="1" Classes="smallIcon" Content="..." FontSize="14" ToolTip.Tip="Настройки градации" Click="DowntimeHeatmapSettingsButton_Click">
        									<Button.Flyout>
        										<Flyout Placement="BottomEdgeAlignedRight">
        											<Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="10">
                                                        <StackPanel Spacing="8" MinWidth="320" MaxWidth="360">
        													<TextBlock Text="Настройки градации карты" FontSize="12" FontWeight="SemiBold" />
        													<TextBlock Text="Диапазон значений для карты простоев" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                                           <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8" VerticalAlignment="Center">
        														<TextBlock Grid.Row="0" Grid.Column="0" Text="Минимум:" FontSize="12" VerticalAlignment="Center" />
        														<NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1000" Increment="1" FormatString="F0" Value="{Binding HeatmapColorMin, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        														<TextBlock Grid.Row="1" Grid.Column="0" Text="Максимум:" FontSize="12" VerticalAlignment="Center" />
        														<NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000" Increment="1" FormatString="F0" Value="{Binding HeatmapColorMax, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        													</Grid>
        												</StackPanel>
        											</Border>
        										</Flyout>
        									</Button.Flyout>
        								</Button>
        							</Grid>
        							<TextBlock Text="Значение ячейки: количество единиц оборудования с неисправностями за день" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" />
                            <views:HeatmapGridControl DayHeaders="{Binding DayHeaders}"
                                                     MonthRows="{Binding DowntimeMonthRows}"
                                                     CellCommand="{Binding ShowDowntimeDayCommand}"
                                                     SelectedDate="{Binding DowntimeAnalysisDate, Mode=TwoWay}"
                                                     ConverterMode="DowntimeAnalysis" />
        						</StackPanel>
        					</Border>
        				</Grid>
        
        				<Grid>
        					<Border Background="Transparent" CornerRadius="8" Margin="0,6,0,0" />
        					<Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        						<StackPanel>
        							<TextBlock Text="Оборудование с неисправностями за выбранный день" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
        							<TextBlock Text="{Binding DowntimeAnalysisDate, StringFormat='Дата: {0:dd.MM.yyyy}'}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" />
        
        							<Grid ColumnDefinitions="2.2*,2.8*" Margin="4,2,4,6">
        								<TextBlock Grid.Column="0" Text="Оборудование" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        								<TextBlock Grid.Column="1" Text="График" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        							</Grid>
        							<Border Height="1" Background="{DynamicResource RowDividerBrush}" Margin="0,0,0,4" />
        
                                  <ItemsControl ItemsSource="{Binding DowntimeDayEquipmentRows}">
        								<ItemsControl.ItemsPanel>
        									<ItemsPanelTemplate>
        										<StackPanel />
        									</ItemsPanelTemplate>
        								</ItemsControl.ItemsPanel>
        								<ItemsControl.ItemTemplate>
        									<DataTemplate>
        										<Border Classes="downtimeEquipmentRow" Margin="4,3" Padding="2">
        											<Grid ColumnDefinitions="2.2*,2.8*" Margin="2,1">
        												<Border Grid.Column="0" Margin="0,0,8,0" Background="Transparent" PointerPressed="DowntimeEquipmentButton_Click">
        													<StackPanel Spacing="2">
        														<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
        														<TextBlock Text="{Binding InventoryNumber, StringFormat='Инв: {0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
        														<TextBlock Text="{Binding IssuesCount, StringFormat='Неисправностей: {0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
        													</StackPanel>
        												</Border>
        												<Border Grid.Column="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Background="{DynamicResource SurfaceBrush}">
        													<views:TimelineControl Items="{Binding TimelinePoints}" RepairsItems="{Binding RepairsTimelinePoints}" SetupsItems="{Binding SetupsTimelinePoints}" Annotations="{Binding Annotations}" Height="56" ShowHourLabels="False" />
        												</Border>
        											</Grid>
        										</Border>
        									</DataTemplate>
        								</ItemsControl.ItemTemplate>
        							</ItemsControl>
        						</StackPanel>
        					</Border>
        				</Grid>
        			</StackPanel>
        		</ScrollViewer>
        
               <Grid x:Name="DowntimeRightColumn" Grid.Column="1" Margin="8,0,0,0" MinWidth="260" MaxWidth="520" HorizontalAlignment="Stretch">
        			<Border Background="{DynamicResource CardBackground}" BoxShadow="0 1 3 0 #12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0" CornerRadius="0" Padding="14">
        				<Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
        					<TextBlock Grid.Row="0" Text="Статистика" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        					<TextBlock Grid.Row="0" Text="Сводка по выбранному дню простоев" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,22,0,0" />
        
        					<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        						<Border Grid.Column="0" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" HorizontalAlignment="Stretch" MinWidth="120">
        							<StackPanel>
        								<TextBlock Text="Дата" FontSize="12" Foreground="{DynamicResource AccentForeground}" />
        								<TextBlock Text="{Binding DowntimeAnalysisDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontWeight="Bold" />
        							</StackPanel>
        						</Border>
                              <Border Grid.Column="1" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Width="120" Margin="8,0,0,0">
        							<StackPanel>
        								<TextBlock Text="Охват" FontSize="12" Foreground="{DynamicResource AccentForeground}" />
        								<TextBlock Text="{Binding DowntimeAffectedSharePercent, StringFormat='{}{0:0.0}%'}" FontWeight="Bold" />
        							</StackPanel>
        						</Border>
        					</Grid>
        
        					<Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
        						<StackPanel Spacing="8">
        							<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
        								<Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        									<StackPanel>
        										<TextBlock Text="Оборудование" FontSize="11" Foreground="{DynamicResource TextMuted}" />
        										<TextBlock Text="{Binding DowntimeAffectedEquipmentCount, StringFormat='{}{0} ед.'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        									</StackPanel>
        								</Border>
        								<Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        									<StackPanel>
        										<TextBlock Text="События" FontSize="11" Foreground="{DynamicResource TextMuted}" />
        										<TextBlock Text="{Binding DowntimeTotalIssues, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        									</StackPanel>
        								</Border>
        								<Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        									<StackPanel>
        										<TextBlock Text="Ремонты" FontSize="11" Foreground="{DynamicResource TextMuted}" />
        										<TextBlock Text="{Binding DowntimeRepairsCount, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        									</StackPanel>
        								</Border>
        								<Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        									<StackPanel>
        										<TextBlock Text="Настройки" FontSize="11" Foreground="{DynamicResource TextMuted}" />
        										<TextBlock Text="{Binding DowntimeSetupsCount, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        									</StackPanel>
        								</Border>
        								<Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        									<StackPanel>
        										<TextBlock Text="Суммарный простой" FontSize="11" Foreground="{DynamicResource TextMuted}" />
        										<TextBlock Text="{Binding DowntimeTotalDuration}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        									</StackPanel>
        								</Border>
        								<Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        									<StackPanel>
        										<TextBlock Text="Ср. событий / ед." FontSize="11" Foreground="{DynamicResource TextMuted}" />
        										<TextBlock Text="{Binding DowntimeAvgIssuesPerEquipment}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        									</StackPanel>
        								</Border>
        							</Grid>
        						</StackPanel>
        					</Border>
        
        					<Border Grid.Row="3" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Stretch">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        						<StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
        							    <TextBlock Text="Показатели дня" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Ключевые инциденты и пиковые периоды" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
 
                                    <Border Height="1" Background="{DynamicResource RowDividerBrush}" />
 
                                    <!-- Группа: Периоды -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="ВРЕМЯ НАГРУЗКИ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" LetterSpacing="0.05" />
                                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
        								    <StackPanel>
        									    <TextBlock Text="Пиковый час по кол-ву оборудования" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" />
        									    <TextBlock Text="{Binding DowntimePeakHour}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        								    </StackPanel>
        							    </Border>
                                    </StackPanel>
 
                                    <Border Height="1" Background="{DynamicResource RowDividerBrush}" />
 
                                    <!-- Группа: Оборудование -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="АНАЛИЗ ИНЦИДЕНТОВ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" LetterSpacing="0.05" />
                                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
        								    <StackPanel Spacing="4">
        									    <TextBlock Text="Максимум событий на оборудование" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock Text="{Binding DowntimeTopEquipment}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
        									    <TextBlock Text="{Binding DowntimeTopEquipmentIssues, StringFormat='{}{0} событий'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentForeground}" />
        								    </StackPanel>
        							    </Border>
                                    </StackPanel>
        						</StackPanel>
                                </ScrollViewer>
        					</Border>
        				</Grid>
        			</Border>
        		</Grid>
    </Grid>
</UserControl>





