<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EquipmentFailureAnalysis.Views"
             x:Class="EquipmentFailureAnalysis.Views.DowntimeView">
    <UserControl.Styles>
        <Style Selector="ScrollViewer.heatmapScroller /template/ ScrollContentPresenter">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="DowntimeLayoutRoot">
        <!-- ====================================================
             CENTER COLUMN — Filters / Heatmap / Equipment rows
             ==================================================== -->
        <ScrollViewer x:Name="DowntimeCenterColumn"
                      Margin="20,18,20,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="14">

                <!-- ============== PAGE HEADER ============== -->
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Анализ простоев" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Карта тепла и детализация инцидентов по дням"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                    <!-- Layout switcher: heatmap full / split -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentSoftBackground}"
                                BorderBrush="{DynamicResource AccentSoftBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="10,5"
                                VerticalAlignment="Center"
                                IsVisible="{Binding DowntimeMonthRows.Count}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource AccentForeground}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DowntimeYearLabel"
                                           Text="{Binding DowntimeHeatmapYearLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentForeground}"
                                            VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
 
                 <!-- ============== UNIVERSAL FILTER BAR ============== -->
                 <!-- Collapsible filter bar — expanded by default for visibility, but compact header -->
                 <Border Classes="panelFlat" Padding="0">
                     <Expander x:Name="FilterExpander" IsExpanded="False" HorizontalAlignment="Stretch">
                         <Expander.Header>
                             <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,2">
                                 <Border Grid.Column="0"
                                         Width="32" Height="32"
                                         CornerRadius="8"
                                         Background="{DynamicResource AccentSoftBackground}"
                                         VerticalAlignment="Center">
                                     <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                                                FontSize="14"
                                                Foreground="{DynamicResource AccentForeground}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                 </Border>
                                 <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center" Margin="10,0,0,0">
                                     <TextBlock Text="Универсальный фильтр" FontSize="12" FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}" />
                                     <TextBlock Text="Тип, статус, ответственный, группа, оборудование"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextMuted}" />
                                 </StackPanel>
 
                                  <Button Grid.Column="2"
                                          Classes="resetFilter"
                                          Content="Сбросить"
                                          Margin="8,0,0,0"
                                          Command="{Binding ResetUniversalFiltersCommand}"
                                          Click="ResetFiltersWithToast_Click" />
                              </Grid>
                          </Expander.Header>

                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <Border Height="1" Background="{DynamicResource RowDividerBrush}" />

                            <Grid ColumnDefinitions="Auto,*,12,Auto,*,12,Auto,*,12,Auto,*"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="8" ColumnSpacing="0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding DowntimeIssueTypeFilters}"
                                          SelectedItem="{Binding SelectedDowntimeIssueTypeFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Статус"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="4"
                                          ItemsSource="{Binding DowntimeStatusFilters}"
                                          SelectedItem="{Binding SelectedDowntimeStatusFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="0" Grid.Column="6" Text="Ответственный"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="7"
                                          ItemsSource="{Binding DowntimeResponsibleFilters}"
                                          SelectedItem="{Binding SelectedDowntimeResponsibleFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="0" Grid.Column="9" Text="Группа"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="10"
                                          ItemsSource="{Binding DowntimeSubdivisionFilters}"
                                          SelectedItem="{Binding SelectedDowntimeSubdivisionFilter, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Оборудование"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="10"
                                         Watermark="Поиск по названию или инв. номеру"
                                         Text="{Binding DowntimeEquipmentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- ============== HEATMAP CARD ============== -->
                <Border Classes="panel" Padding="0">
                    <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Карта тепла" Classes="sectionTitle" />
                                    <TextBlock Text="Значение ячейки — количество единиц оборудования с неисправностями за день"
                                               Classes="sectionSubtitle" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="smallIcon"
                                        ToolTip.Tip="Настройки градации"
                                        Click="DowntimeHeatmapSettingsButton_Click"
                                        Margin="0,0,16,0">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <Border Background="{DynamicResource CardBackground}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10" Padding="14">
                                                <StackPanel Spacing="10" MinWidth="320" MaxWidth="360">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Настройки градации карты"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="Диапазон значений для карты простоев"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border Height="1" Background="{DynamicResource RowDividerBrush}" />
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                                          ColumnSpacing="10" RowSpacing="8" VerticalAlignment="Center">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Минимум"
                                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                                   VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1000"
                                                                       Increment="1" FormatString="F0"
                                                                       Value="{Binding $parent[Window].DataContext.HeatmapColorMin, Mode=TwoWay}"
                                                                       HorizontalAlignment="Stretch" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Максимум"
                                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                                   VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000"
                                                                       Increment="1" FormatString="F0"
                                                                       Value="{Binding $parent[Window].DataContext.HeatmapColorMax, Mode=TwoWay}"
                                                                       HorizontalAlignment="Stretch" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <Border Height="1" Background="{DynamicResource RowDividerBrush}" />

                            <Border Classes="well" Padding="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <Button x:Name="DowntimeHeatmapScrollLeftButton"
                                            Grid.Column="0"
                                            Classes="soft"
                                            Width="32" Height="32"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="8,0"
                                            CornerRadius="16"
                                            Click="HeatmapScrollLeft_Click"
                                            ToolTip.Tip="Предыдущие месяцы">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>

                                    <ScrollViewer x:Name="DowntimeHeatmapScroller"
                                                  Grid.Column="1"
                                                  Classes="heatmapScroller"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Background="Transparent"
                                                  HorizontalAlignment="Center"
                                                  ClipToBounds="True">
                                        <views:HeatmapGridControl DayHeaders="{Binding DayHeaders}"
                                                                 MonthRows="{Binding DowntimeMonthRows}"
                                                                 CellCommand="{Binding ShowDowntimeDayCommand}"
                                                                 SelectedDate="{Binding DowntimeAnalysisDate, Mode=TwoWay}"
                                                                 ConverterMode="DowntimeAnalysis" />
                                    </ScrollViewer>

                                    <Button x:Name="DowntimeHeatmapScrollRightButton"
                                            Grid.Column="2"
                                            Classes="soft"
                                            Width="32" Height="32"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="8,0"
                                            CornerRadius="16"
                                            Click="HeatmapScrollRight_Click"
                                            ToolTip.Tip="Следующие месяцы">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>

                                    <!-- Empty state for heatmap -->
                                    <Border Grid.ColumnSpan="3"
                                            Classes="emptyState"
                                            IsVisible="{Binding DowntimeMonthRows.Count, Converter={StaticResource IsEmptyConverter}}">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="320">
                                            <Border Width="44" Height="44" CornerRadius="12"
                                                    Background="{DynamicResource AccentSoftBackground}">
                                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="22"
                                                           Foreground="{DynamicResource AccentForeground}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Classes="emptyStateTitle" Text="Нет данных для отображения"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Classes="emptyStateSubtitle"
                                                       Text="Импортируйте данные из XML или Jira, чтобы увидеть карту простоев"
                                                       HorizontalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Legend (reactive to HeatmapColorMin/Max) -->
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,2,0,0">
                                <TextBlock Text="Градация:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="22" Height="12" Background="{StaticResource HeatmapGreen}" CornerRadius="4" />
                                    <TextBlock Text="{Binding $parent[Window].DataContext.HeatmapColorMin, StringFormat='до {0}'}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="22" Height="12" Background="{StaticResource HeatmapYellow}" CornerRadius="4" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}–{1}">
                                                <Binding Path="$parent[Window].DataContext.HeatmapColorMin" />
                                                <Binding Path="$parent[Window].DataContext.HeatmapColorMax" Converter="{StaticResource HeatmapMidValueConverter}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="22" Height="12" Background="{StaticResource HeatmapOrange}" CornerRadius="4" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}–{1}">
                                                <Binding Path="$parent[Window].DataContext.HeatmapColorMax" Converter="{StaticResource HeatmapMidValueConverter}" />
                                                <Binding Path="$parent[Window].DataContext.HeatmapColorMax" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="22" Height="12" Background="{StaticResource HeatmapRed}" CornerRadius="4" />
                                    <TextBlock Text="{Binding $parent[Window].DataContext.HeatmapColorMax, StringFormat='от {0}'}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- ============== SELECTED DAY SUMMARY DASHBOARD ============== -->
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <!-- Dashboard Header with Date and Presets -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Сводные показатели за день" Classes="sectionTitle" />
                                <TextBlock Text="{Binding DowntimeAnalysisDate, StringFormat='Выбранная дата: {0:dd.MM.yyyy}'}"
                                           Classes="sectionSubtitle" />
                            </StackPanel>
                            <!-- Date navigation presets -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="soft" Content="Вчера" Click="DowntimeSetYesterday_Click" />
                                <Button Classes="soft" Content="Сегодня" Click="DowntimeSetToday_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- If there are incidents (HasDowntimeIssues = true) -->
                        <Border Classes="well" IsVisible="{Binding HasDowntimeIssues}">
                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="12" RowDefinitions="Auto">
                                <!-- События -->
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Всего событий" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding DowntimeTotalIssues, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>

                                <!-- Ремонты -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Ремонты" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding DowntimeRepairsCount, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>

                                <!-- Настройки -->
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Настройки" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding DowntimeSetupsCount, StringFormat='{}{0} шт.'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>

                                <!-- Время простоев -->
                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock Text="Время простоев" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding DowntimeTotalDuration}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>

                                <!-- Охват -->
                                <StackPanel Grid.Column="4" Spacing="4">
                                    <TextBlock Text="Охват" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding DowntimeAffectedSharePercent, StringFormat='{}{0:0.0}%'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>

                                <!-- Пиковый час -->
                                <StackPanel Grid.Column="5" Spacing="4">
                                    <TextBlock Text="Пиковый час" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding DowntimePeakHour}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentForeground}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- If there are NO incidents (HasDowntimeIssues = false) -->
                        <Border Classes="well" IsVisible="{Binding !HasDowntimeIssues}" Background="{DynamicResource SuccessSoftBackground}" BorderBrush="{DynamicResource SuccessSoftBorder}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="6"
                                            Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Неисправностей не зафиксировано"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessStrongBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="За выбранный день отсутствуют простои, ремонты и перенастройки оборудования."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============== EQUIPMENT LIST CARD ============== -->
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Оборудование с неисправностями за выбранный день"
                                           Classes="sectionTitle" />
                                <TextBlock Text="Детализированный список и графики работы оборудования"
                                           Classes="sectionSubtitle" />
                            </StackPanel>
                        </Grid>

                        <Border Classes="well" Padding="0">
                            <Grid>
                                <StackPanel>
                                    <!-- Sticky header row -->
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                                             BorderThickness="0,0,0,1"
                                             CornerRadius="10,10,0,0"
                                             Padding="14,10">
                                        <Grid ColumnDefinitions="2.2*,2.8*">
                                            <TextBlock Grid.Column="0" Text="Оборудование"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="График работ и простоев"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                    </Border>

                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                   VerticalScrollBarVisibility="Auto"
                                                   MaxHeight="420">
                                        <ItemsControl ItemsSource="{Binding DowntimeDayEquipmentRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="downtimeEquipmentRow"
                                                             BorderBrush="{DynamicResource RowDividerBrush}"
                                                             BorderThickness="0,0,0,1"
                                                             Margin="0" Padding="10,8">
                                                        <Grid ColumnDefinitions="2.2*,2.8*" Margin="2,1">
                                                            <Border Grid.Column="0" Margin="0,0,8,0" Background="Transparent"
                                                                    PointerPressed="DowntimeEquipmentButton_Click">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                                    <TextBlock Text="{Binding InventoryNumber, StringFormat='Инв. номер: {0}'}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource TextMuted}" />
                                                                    <TextBlock Text="{Binding IssuesCount, StringFormat='Неисправностей: {0}'}"
                                                                               FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AccentForeground}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="1"
                                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                    BorderThickness="1" CornerRadius="8" Padding="6,8"
                                                                    Background="{DynamicResource SurfaceBrush}"
                                                                    VerticalAlignment="Center">
                                                                <views:TimelineControl Height="48" ShowHourLabels="True" ShowAnnotations="False" EnableTooltips="True"
                                                                                       RepairsItems="{Binding RepairsTimelinePoints}"
                                                                                       SetupsItems="{Binding SetupsTimelinePoints}"
                                                                                       Annotations="{Binding Annotations}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Empty state overlay — shown when list is empty -->
                                <Border IsVisible="{Binding DowntimeDayEquipmentRows.Count, Converter={StaticResource IsEmptyConverter}}"
                                        Background="{DynamicResource SuccessSoftBackground}"
                                        BorderBrush="{DynamicResource SuccessSoftBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="24,18"
                                        Margin="14">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="24" Height="24" CornerRadius="6"
                                                    Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Неисправностей не зафиксировано"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessStrongBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="За выбранный день нет событий по оборудованию"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
