<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EquipmentFailureAnalysis.App"
             xmlns:local="using:EquipmentFailureAnalysis"
             RequestedThemeVariant="Light">
             <!-- Фиксированная тема, не зависящая от системной темы Windows -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>